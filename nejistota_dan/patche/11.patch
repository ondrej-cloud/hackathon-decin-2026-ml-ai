+def vyhlad_nizkou_vodu(cil, ted, pred, posledni):
+    """Předpověď k zobrazení při nízké vodě: když je hladina teď i předpověď pod 1. stupněm, průměr předpovědí vydaných
+    v t − 2 h, t − 1 h a t, jinak předpověď z t beze změny. Při nízké vodě předpověď kmitá podle odtoku z vodních děl
+    (provozní data 25. 9.–23. 10. 2026: hodinová změna 6,2 cm, realita 2,2); varování od 2. stupně se tím nemění
+    (nejistota_dan/KMITANI.md). posledni = {h: [předpovědi vydané v t − 2 h, t − 1 h, t]}."""
+    prah = SPA[cil][0]
+    return {h: sum(posledni[h]) / len(posledni[h]) if ted < prah and p < prah else p for h, p in pred.items()}
