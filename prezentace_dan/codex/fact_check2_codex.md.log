| +24 h | 15,07 | 16,05 | +0,98 | 8 z 22 | 0,29 | +8,0 | 39,2 / 34,1 | 15,6 / 23,4 |
| +36 h | 26,89 | 26,02 | −0,87 | 15 z 22 | 0,13 | +12,4 | 61,4 / 54,2 | 39,7 / 29,7 |

