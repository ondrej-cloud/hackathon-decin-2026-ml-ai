| 0,5 | 14,79 | −0,49 | 15 | +6,5 | ne | 34,1 | 23,3 | 3 |
| 0,25 | 14,80 | −0,49 | 15 | +6,5 | ne | 34,1 | 23,2 | 3 |
| 0,1 | 14,81 | −0,47 | 16 | +6,4 | ne | 34,4 | 23,1 | 3 |
| 0,05 | 14,85 | −0,43 | 16 | +6,1 | ne | 35,1 | 22,8 | 3 |
