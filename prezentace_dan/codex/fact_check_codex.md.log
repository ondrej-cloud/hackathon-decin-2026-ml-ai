574:// index úrovně rozlivu pro hladinu h: z terénu nejbližší hladina, z DIBAVOD největší dosažené území (-1 = nic)
575:function uroven(h) {
576:  if (h == null) return -1;
577:  const U = A.urovne;
578:  if (A.zdroj === 'dem') {
579:    let a = 0, b = U.length - 1;
580:    while (b - a > 1) { const c = (a + b) >> 1; if (U[c].h <= h) a = c; else b = c; }
581:    return Math.abs(U[a].h - h) <= Math.abs(U[b].h - h) ? a : b;
582:  }
583:  let k = -1;
584:  U.forEach((u, i) => { if (h >= u.h) k = i; });
585:  return k;
586:}
587:const hladinaMapy = (m, i) => (m === mapaB || (rezim !== 'porovnani' && podle === 'skutecnost')) ? A.H[i] : A.P[i];
