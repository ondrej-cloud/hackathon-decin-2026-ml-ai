+import importlib.metadata as metadata
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / '.repro_audit'
+env = os.environ.copy()
+env.update(PYTHONUTF8='1', PYTHONDONTWRITEBYTECODE='1', MPLBACKEND='Agg',
+           MPLCONFIGDIR=str(OUT / 'mpl'), TEMP=str(OUT / 'tmp'), TMP=str(OUT / 'tmp'),
+           XDG_CACHE_HOME=str(OUT / 'cache'), STREAMLIT_BROWSER_GATHER_USAGE_STATS='false',
+           OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1', MKL_NUM_THREADS='1')
+env.pop('MAPBOX_TOKEN', None)
+for name in ('mpl', 'tmp', 'cache'):
+    (OUT / name).mkdir(exist_ok=True)
+
+GUARD = r'''
+import os, sys, runpy
+from pathlib import Path
+root = Path.cwd().resolve()
+def audit(event, args):
+    if event == 'open' and isinstance(args[0], (str, bytes, os.PathLike)):
+        p = Path(os.fsdecode(args[0])).resolve()
+        low = str(p).lower().replace('\\', '/')
+        if p.name.lower().startswith('.env') or '/.kaggle/' in low or p.name.lower() in ('credentials.toml', '.netrc', '_netrc'):
+            raise PermissionError('AUDIT: credential file read blocked')
+        mode, flags = args[1:3]
+        writing = (isinstance(mode, str) and any(c in mode for c in 'wax+')) or (isinstance(flags, int) and flags & (os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC))
+        if writing and not p.is_relative_to(root):
+            raise PermissionError('AUDIT: outside write blocked: ' + str(p))
+    if event in ('os.mkdir', 'os.remove', 'os.rmdir', 'os.rename'):
+        for arg in args[:2] if event == 'os.rename' else args[:1]:
+            if isinstance(arg, (str, bytes, os.PathLike)) and not Path(os.fsdecode(arg)).resolve().is_relative_to(root):
+                raise PermissionError('AUDIT: outside mutation blocked')
+    if event in ('socket.connect', 'socket.getaddrinfo'):
+        raise PermissionError('AUDIT: network disabled')
+sys.addaudithook(audit)
+script = sys.argv[1]
+sys.argv = sys.argv[1:]
+sys.path.insert(0, str((root / script).parent))
+if script == 'app/test_app.py':
+    sys.path.insert(0, str(root / 'app'))
+    import mapa
+    mapa.mapbox_token = lambda: None
+if script == 'src/procenta.py':
+    from matplotlib.figure import Figure
+    save = Figure.savefig
+    def redirected(self, fname, *args, **kwargs):
+        return save(self, root / '.repro_audit' / Path(fname).name, *args, **kwargs)
+    Figure.savefig = redirected
+runpy.run_path(script, run_name='__main__')
+'''
+
+if sys.argv[1] == 'environment':
+    import platform
+    print(sys.version)
+    print(platform.platform())
+    for name in ('pandas', 'numpy', 'scikit-learn', 'lightgbm', 'streamlit', 'matplotlib', 'pyarrow', 'joblib', 'plotly', 'pydeck', 'xgboost', 'torch', 'requests', 'scipy'):
+        try:
+            print(name, metadata.version(name))
+        except metadata.PackageNotFoundError:
+            print(name, 'CHYBI')
+    raise SystemExit()
+
+label, timeout, *command = sys.argv[1:]
+start = time.monotonic()
+log = OUT / (label + '.log')
+with log.open('w', encoding='utf-8') as f:
+    child = subprocess.Popen([sys.executable, '-u', '-c', GUARD, *command], cwd=ROOT, env=env, stdout=f, stderr=subprocess.STDOUT)
+    try:
+        code = child.wait(timeout=float(timeout))
+    except subprocess.TimeoutExpired:
+        child.kill()
+        child.wait()
+        code = 'TIMEOUT'
+elapsed = round(time.monotonic() - start, 2)
+record = dict(command=command, code=code, seconds=elapsed, log=str(log.relative_to(ROOT)))
+with (OUT / 'runs.jsonl').open('a', encoding='utf-8') as f:
+    f.write(json.dumps(record, ensure_ascii=False) + '\n')
+print(json.dumps(record, ensure_ascii=False))
+print(log.read_text(encoding='utf-8'))

