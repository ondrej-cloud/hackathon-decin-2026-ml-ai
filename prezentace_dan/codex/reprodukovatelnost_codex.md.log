+import importlib.metadata as metadata
+import sys
+import subprocess
+from io import BytesIO
+from pathlib import Path
+
+root = Path.cwd()
+sys.path.insert(0, str(root / 'src'))
+for name in ('pandas', 'sklearn', 'lightgbm', 'xgboost', 'streamlit', 'pyarrow', 'plotly', 'pydeck', 'requests', 'joblib'):
+    importlib.import_module(name)
+    print('IMPORT OK', name)
+for name in ('pyproj', 'pillow', 'scipy'):
+    try:
+        print('PRIPRAVA MAP', name, metadata.version(name))
+    except metadata.PackageNotFoundError:
+        print('PRIPRAVA MAP', name, 'CHYBI')
+from data import nacti
+d = nacti()
+print('DATA', d.shape, str(d.index.min()), str(d.index.max()))
+print('CHYBEJICI', d.isna().sum()[lambda s: s > 0].to_dict())
+import pyarrow.parquet as pq
+for name in ('ridge', 'jako_ted', 'mlp', 'lgbm', 'fyzika'):
+    f = root / 'results' / 'predpovedi' / (name + '.parquet')
+    t = pq.read_table(f, columns=['cas_vydani'])
+    dates = t.column('cas_vydani').to_pandas()
+    assert dates.dt.year.max() <= 2020
+    print('PREDPOVEDI VAL', name, len(dates), str(dates.min()), str(dates.max()))
+import pandas as pd
+original = subprocess.run(['git', 'show', 'HEAD:results/predpovedi/ridge.parquet'], capture_output=True, check=True).stdout
+before = pd.read_parquet(BytesIO(original))
+after = pd.read_parquet(root / 'results/predpovedi/ridge.parquet')
+assert before.index.equals(after.index)
+assert before[['cil', 'horizont', 'skutecnost']].equals(after[['cil', 'horizont', 'skutecnost']])
+print('RIDGE PROTI GITU: max rozdil predpovedi cm', (before.predpoved - after.predpoved).abs().max())
