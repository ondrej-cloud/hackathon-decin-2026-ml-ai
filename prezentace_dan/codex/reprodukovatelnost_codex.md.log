"""Povodeň v lednu 2011 na 3D mapě Labe a přítoků."""

import os
import sys
from datetime import datetime, timedelta
from functools import cache
from pathlib import Path

import pandas as pd
import pydeck as pdk
import streamlit as st

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from data import SPA, nacti


PASMO = "Europe/Prague"
PREHANI = 2.5
MERITKO_PRUTOKU = 5
BARVY = ([40, 165, 92], [250, 204, 21], [249, 115, 22], [220, 38, 38])
SEDA = [130, 140, 150]
# Zaokrouhlené výšky z Terrarium; backend při posunu času nepotřebuje síť.
VYSKY = {
    "decin": 126, "usti": 145, "louny": 179, "melnik": 161,
    "vranany": 163, "kostelec": 165, "praha": 191, "nymburk": 182,
    "jizera": 180, "beroun": 219, "sazava": 279, "prelouc": 208,
}


def mapbox_token():
    """Veřejný token Mapboxu z proměnné MAPBOX_TOKEN nebo z .env v kořeni repa; bez něj OpenStreetMap."""
    token = os.environ.get("MAPBOX_TOKEN")
    env = ROOT / ".env"
    if not token and env.exists():
        for radek in env.read_text(encoding="utf-8").splitlines():
            if radek.startswith("MAPBOX_TOKEN="):
                token = radek.split("=", 1)[1].strip().strip('"')
    return token or None


@cache
def _podklady():
    stanice = pd.read_csv(ROOT / "data/external/stanice_hydro.csv")
    percentily = nacti().loc["2006":"2018"].filter(regex="_Q$").quantile([0.95, 0.99])
    return stanice, percentily


def _cas_utc(cas):
    cas = pd.Timestamp(cas)
    if cas.tzinfo is None:
        cas = cas.tz_localize(PASMO)
    return cas.tz_convert("UTC")


def _cislo(hodnota):
    return "chybí měření" if pd.isna(hodnota) else f"{hodnota:,.0f}".replace(",", " ")


def _stanice(cas, predpovedi=None, tabulka=None):
    """predpovedi: {klic: (horizont, hladina_cm)} z modelu, přidá se k popisku Děčína a Ústí.
    tabulka: hodinová tabulka se sloupci jako data.nacti() místo archivu (živá data ČHMÚ pro dnešek)."""
    metadata, percentily = _podklady()
    radek = (nacti() if tabulka is None else tabulka).loc[_cas_utc(cas)]
    body = []
    for stanice in metadata.itertuples(index=False):
        klic = stanice.klic
        q = radek[f"{klic}_Q"]
        barva = SEDA
        tooltip = f"{stanice.stanice} · {stanice.tok}\nPrůtok: {_cislo(q)}"
        predpoved = ""
        if pd.notna(q):
            tooltip += " m³/s"
        if klic in SPA:
            h = radek[f"{klic}_H"]
            stupen = sum(h >= mez for mez in SPA[klic]) if pd.notna(h) else None
            stav = "stupeň nelze určit" if stupen is None else (
                "bez stupně povodňové aktivity" if stupen == 0 else f"{stupen}. stupeň povodňové aktivity"
            )
            barva = SEDA if stupen is None else BARVY[stupen]
            tooltip += f"\nHladina: {_cislo(h)}" + (" cm" if pd.notna(h) else "")
            tooltip += f"\n{stav}"
            if predpovedi and klic in predpovedi:
                hor, cm = predpovedi[klic]
                s = sum(cm >= mez for mez in SPA[klic])
                predpoved = f"\nza {hor} h: {cm:.0f} cm" + (f", {s}. stupeň" if s else "")
                tooltip += f"\nPředpověď modelu{predpoved}"
        else:
            p95, p99 = percentily[f"{klic}_Q"]
            if pd.notna(q):
                kategorie = 3 if q >= p99 else (1 if q >= p95 else 0)
                barva = BARVY[kategorie]
                stav = {0: "pod 95. percentilem", 1: "od 95. do 99. percentilu", 3: "od 99. percentilu"}[kategorie]
                tooltip += f"\nPrůtok {stav} (2006–2018)"
            tooltip += f"\n95. / 99. percentil: {_cislo(p95)} / {_cislo(p99)} m³/s"
            tooltip += "\nHladinu nemáme; barva není oficiální povodňový stupeň."
        # Odhad výšky paty s malou rezervou kvůli hrubší síti terénu.
        z = VYSKY[klic] * PREHANI + 40
        vyska = float(q) if pd.notna(q) else 0.0
"""Předpověď pro aplikaci: uložené modely (models/<model>_<cil>_<h>.joblib) a vstupy ze src/features.py.

Když modely Ridge chybí, natrénuje je stejně jako src/uloz_model.py (trénovací část, asi 5 s).
"""
import json
import sys
from functools import cache
from pathlib import Path

import joblib

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from data import CILE, PROTI_PROUDU, SPA, nacti  # noqa: E402
from features import tabulka  # noqa: E402

MODELS = ROOT / "models"
HORIZONTY = (12, 24, 36)
NAZEV = {k: v[1] for k, v in (CILE | PROTI_PROUDU).items()}
KDE = {"decin": "v Děčíně", "usti": "v Ústí nad Labem"}
STUPNE = ["pod 1. stupněm", "1. stupeň (bdělost)", "2. stupeň (pohotovost)", "3. stupeň (ohrožení)"]
BARVY = ["#2e7d32", "#f2c437", "#ef6c00", "#c62828"]


def modely():
    """Modely, které mají v models/ aspoň jeden soubor; ridge vždy, ten se umí dotrénovat."""
    nazvy = {f.name.rsplit("_", 2)[0] for f in MODELS.glob("*_*_*.joblib")} if MODELS.exists() else set()
    return sorted(nazvy | {"ridge", "ridge_vse"})


def nacti_model(nazev, cil, h):
    soubor = MODELS / f"{nazev}_{cil}_{h}.joblib"
    if not soubor.exists():
        if nazev not in ("ridge", "ridge_vse"):
            raise FileNotFoundError(f"chybí {soubor}, uloží ho autor modelu")
        from evaluate import casti
        from models import ridge
        X, y = tabulka(cil, h)
        # ridge se učí do 2018 (pro přehrávání historie), ridge_vse na všem do 2025 (pro dnešek)
        tr = (casti(cil, h).reindex(X.index) == "train") | (nazev == "ridge_vse")
        MODELS.mkdir(exist_ok=True)
        joblib.dump(ridge.pipeline(ridge.PARAMETRY["alpha"]).fit(X[tr], y[tr]), soubor)
    return joblib.load(soubor)


def vstupy(cil):
    """Vstupy pro všechny hodiny 2006–2025, kde jsou úplné (index UTC). Na horizontu nezávisí."""
    return tabulka(cil, HORIZONTY[0])[0]


def stupen(cil, hladina):
    """0 = bez stupně, 1 až 3 = stupeň povodňové aktivity."""
    return sum(hladina >= p for p in SPA[cil])


def predpoved(nazev, cil, radek):
    """Předpovědi za 12/24/36 h z jednoho řádku vstupů (DataFrame s jedním řádkem): {h: cm}."""
    return {h: float(nacti_model(nazev, cil, h).predict(radek)[0]) for h in HORIZONTY}


@cache
def _intervaly():
    soubor = MODELS / "ridge_intervaly.json"
    return json.loads(soubor.read_text(encoding="utf-8")) if soubor.exists() else None


def interval(nazev, cil, h, hladina_ted, pred):
    """Rozmezí (dolní, horní) v cm, do kterého se vešlo 90 % chyb na tréninku v pásmu hladiny teď; jen pro ridge."""
    z = _intervaly()
    if nazev not in ("ridge", "ridge_vse") or not z:
        return None
    z = z[f"{cil}_{h}"]
    i = max(k for k, hranice in enumerate(z["pasma"][:-1]) if hladina_ted >= hranice)
    return pred + z["dolni"][i], pred + z["horni"][i]


def trend(ted, drive):
    return "stoupá" if ted > drive * 1.05 else "klesá" if ted < drive * 0.95 else "drží se"


def vysvetleni(cil, h, ted, pred, radek):
    """Jedna věta pro laika, proč to tak vyšlo: co teče Prahou a Mělníkem."""
    r = radek.iloc[0]
    return (f"Za {h} h bude {KDE[cil]} asi {pred:.0f} cm, to je {STUPNE[stupen(cil, pred)]}; teď je {ted:.0f} cm. "
            f"Vltava v Praze teče {r['praha_Q_0']:.0f} m³/s a {trend(r['praha_Q_0'], r['praha_Q_6'])}, "
            f"Labe v Mělníku {r['melnik_Q_0']:.0f} m³/s a {trend(r['melnik_Q_0'], r['melnik_Q_6'])}. "
            f"Tahle voda doteče do Ústí a Děčína zhruba za půl dne až den.")
