- [ ] (kdo chce Kaggle) test GPU na Kaggle doběhl
"""Natrénuje a vyhodnotí modely ze src/models/ na společném rozdělení a uloží výsledky do results/.

python src/porovnej.py jako_ted ridge      Děčín a Ústí za 12, 24 a 36 h, validace
python src/porovnej.py ridge --rychle      jen Děčín za 24 h
python src/porovnej.py --prehled           poslední výsledek každého modelu vedle sebe
python src/porovnej.py ridge --test        finální test, spouští jen Ondra

Model je soubor src/models/<nazev>.py s funkcí fit(X, y, cil, horizont), která vrátí funkci predict(X).
Volitelně PARAMETRY = {...}, uloží se k výsledku.
"""
import argparse
import hashlib
import importlib
import json
import subprocess
import time
from datetime import datetime
from pathlib import Path

import numpy as np
import pandas as pd

from evaluate import casti, vyhodnot
from features import tabulka

ROOT = Path(__file__).resolve().parents[1]
RESULTS = ROOT / "results"
VSE = [(c, h) for c in ("decin", "usti") for h in (12, 24, 36)]
SLOUPCE = ["mae", "mae_povodne", "bias_povodne", "chyba_vrcholu", "spa2_predstih_h", "spa2_propasnuto", "spa2_plane_poplachy",
           "spa3_predstih_h", "spa3_propasnuto", "trenink_s"]


def verze():
    """Otisk dat, vstupů a vyhodnocení. Výsledky s jiným otiskem --prehled nemíchá s novými."""
    h = hashlib.sha1()
    for f in ("data/external/labe_hodinove.parquet", "src/features.py", "src/evaluate.py"):
        h.update((ROOT / f).read_bytes())
    return h.hexdigest()[:8]


def spust(nazev, test=False, rychle=False):
    model = importlib.import_module(f"models.{nazev}")
    cast = "test" if test else "val"
    radky, predpovedi = [], []
    for cil, h in [("decin", 24)] if rychle else VSE:
        X, y = tabulka(cil, h)
        c = casti(cil, h, finalni=test).reindex(X.index)
        tr, ev = c == "train", c == cast
        t0 = time.time()
        predict = model.fit(X[tr], y[tr], cil=cil, horizont=h)
        t1 = time.time()
        pred = pd.Series(np.asarray(predict(X[ev]), dtype=float), index=X.index[ev])
        assert np.isfinite(pred).all(), f"{nazev} vrátil NaN nebo nekonečno ({cil} +{h} h)"
        m = vyhodnot(y[ev], pred, cil, h)
        radky.append(dict(model=nazev, cil=cil, horizont=h, **m, trenink_s=round(t1 - t0, 1),
                          predpoved_s=round(time.time() - t1, 2)))
        predpovedi.append(pd.DataFrame({"cil": cil, "horizont": h, "skutecnost": y[ev], "predpoved": pred}))
        print(f"  {nazev} {cil} +{h} h: MAE {m['mae']} cm, na povodních {m['mae_povodne']} cm")

    cas = datetime.now()
    autor = subprocess.run(["git", "config", "user.name"], capture_output=True, text=True).stdout.strip()
    zaznam = dict(autor=autor, cas=cas.isoformat(timespec="seconds"), verze=verze(), model=nazev, cast=cast, rychle=rychle,
                  popis=(model.__doc__ or "").strip().split("\n")[0],
                  parametry=getattr(model, "PARAMETRY", {}), vysledky=radky)
    RESULTS.mkdir(exist_ok=True)
    soubor = RESULTS / f"{cas:%Y-%m-%d_%H%M%S}_{nazev}{'_test' if test else ''}.json"
    soubor.write_text(json.dumps(zaznam, ensure_ascii=False, indent=1), encoding="utf-8")
    if not rychle:
        (RESULTS / "predpovedi").mkdir(exist_ok=True)
        pd.concat(predpovedi).rename_axis("cas_vydani").to_parquet(
            RESULTS / "predpovedi" / f"{nazev}{'_test' if test else ''}.parquet")
    print(f"uloženo {soubor.relative_to(ROOT)}")
    return pd.DataFrame(radky)


def prehled(cast="val"):
    posledni, stare = {}, set()
    for f in sorted(RESULTS.glob("*.json")):
        b = f.read_bytes()
        try:
            z = json.loads(b.decode("utf-8"))
        except UnicodeDecodeError:  # starší výsledky z Windows bez UTF-8
            z = json.loads(b.decode("cp1250"))
        if z["cast"] != cast or z.get("rychle"):
            continue
        if z.get("verze") == verze():
            posledni[z["model"]] = z
        else:
            stare.add(z["model"])
    if stare - set(posledni):
        print("jen se starou verzí dat nebo vyhodnocení (pusť je znovu):", ", ".join(sorted(stare - set(posledni))))
    if not posledni:
        return pd.DataFrame()
    return pd.DataFrame([r for z in posledni.values() for r in z["vysledky"]])


def tisk(df):
    if df.empty:
        print("zatím žádné výsledky")
        return
    print(df.set_index(["cil", "horizont", "model"]).sort_index()[SLOUPCE].to_string())


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("modely", nargs="*")
    p.add_argument("--rychle", action="store_true")
    p.add_argument("--prehled", action="store_true")
    p.add_argument("--test", action="store_true")
    a = p.parse_args()
    if a.prehled:
        tisk(prehled("test" if a.test else "val"))
    else:
        df = pd.concat([spust(m, test=a.test, rychle=a.rychle) for m in a.modely])
        tisk(df)
        if not a.rychle:
            print("\nprumer_povodne (průměr mae_povodne přes všech 6 kombinací):")
            print(df.groupby("model").mae_povodne.mean().round(1).sort_values().to_string())
"""Uloží modely Ridge pro aplikaci: models/<nazev>_<cil>_<h>.joblib, objekt s metodou predict(X).

python src/uloz_model.py          ridge: trénink na trénovací části (do 2018, stejně jako porovnej.py), pro přehrávání
python src/uloz_model.py --vse    ridge_vse: trénink na všech datech 2006–2025, pro předpověď na dnešek
"""
import sys
from pathlib import Path

import joblib

from evaluate import casti
from features import tabulka
from models import ridge

ROOT = Path(__file__).resolve().parents[1]
MODELS = ROOT / "models"

if __name__ == "__main__":
    MODELS.mkdir(exist_ok=True)
    vse = "--vse" in sys.argv
    for cil in ("decin", "usti"):
        for h in (12, 24, 36):
            X, y = tabulka(cil, h)
            tr = (casti(cil, h).reindex(X.index) == "train") | vse
            model = ridge.pipeline(ridge.PARAMETRY["alpha"]).fit(X[tr], y[tr])
            soubor = MODELS / f"{'ridge_vse' if vse else 'ridge'}_{cil}_{h}.joblib"
            joblib.dump(model, soubor)
            print(f"{soubor.relative_to(ROOT)}: {soubor.stat().st_size / 1e3:.0f} kB, "
                  f"poslední řádek {X.index[-1]:%Y-%m-%d %H:%M} → {model.predict(X.tail(1))[0]:.0f} cm")
r"""Kontrola aplikace bez prohlížeče (Streamlit AppTest). Spouští se z kořene repozitáře:

    Windows:  $env:PYTHONUTF8=1; .venv\Scripts\python app\test_app.py
    Mac:      .venv/bin/python app/test_app.py

Přepínač --dnesek navíc zapne živá data ČHMÚ (potřebuje internet).
Kód ukončení je 0, když všechno prošlo, jinak 1.
"""
import logging
import re
import sys
import time
from pathlib import Path

APP = Path(__file__).resolve().parent
sys.path.insert(0, str(APP))
sys.stdout.reconfigure(encoding="utf-8")

from streamlit.testing.v1 import AppTest  # noqa: E402

logging.getLogger("streamlit.runtime.scriptrunner_utils.script_run_context").addFilter(
    lambda zaznam: "ScriptRunContext" not in zaznam.getMessage())  # bez serveru Streamlit hlásí zbytečné varování

ZALOZKY = ["Teď", "Jak dobře to funguje", "Mapa povodí", "Animace povodně"]
METRIKY = ["Hladina teď", "Za 12 h", "Za 24 h", "Za 36 h"]
VALIDACNI = ["4/2006", "3/2009", "9/2010", "1/2011"]
BORIS = "9/2024 Boris (test)"


def nova():
    return AppTest.from_file(str(APP / "app.py"), default_timeout=300).run()


def bez_vyjimky(at):
    assert not at.exception, f"výjimka v aplikaci: {at.exception[0].value}"


def prvek(seznam, label, key=None):
    """Prvek podle popisku a klíče (selectbox, radio a toggle v AppTestu nemají jednodušší přístup)."""
    nalezene = [w for w in seznam if w.label == label and w.key == key]
    assert nalezene, f"chybí ovládací prvek „{label}“"
    return nalezene[0]


def metriky(at):
    assert [m.label for m in at.metric] == METRIKY, f"metriky: {[m.label for m in at.metric]}"
    return {m.label: int(re.search(r"-?\d+", m.value).group()) for m in at.metric}


def krok_nabehne():
    at = nova()
    bez_vyjimky(at)
    assert not at.error, f"chybová hláška: {at.error[0].value}"


def krok_zalozky():
    at = nova()
    assert [t.label for t in at.tabs] == ZALOZKY, f"záložky: {[t.label for t in at.tabs]}"


def krok_ted():
    at = nova()
    m = metriky(at)
    assert m["Hladina teď"] == 646, f"hladina teď {m['Hladina teď']} cm, čekáno 646"
    assert abs(m["Za 24 h"] - 738) <= 3, f"za 24 h {m['Za 24 h']} cm, čekáno asi 738"
    odznaky = [x.value for x in at.markdown if "<span" in x.value]
    assert len(odznaky) == 4 and "3. stupeň" in odznaky[2], "odznak za 24 h není 3. stupeň"
    assert "3. stupeň" in at.info[0].value, f"věta pro laika: {at.info[0].value[:80]}"
    assert len(at.get("plotly_chart")) == 2, "chybí graf"
    return f"hladina {m['Hladina teď']} cm, za 24 h {m['Za 24 h']} cm, 3. stupeň"


def krok_usti():
    # radio s format_func se nastavuje popiskem z menu, ne klíčem decin / usti
    at = nova()
    decin = metriky(at)["Hladina teď"]
    prvek(at.sidebar.radio, "Stanice").set_value("Ústí nad Labem").run()
    bez_vyjimky(at)
    assert at.main.subheader[0].value.startswith("Ústí nad Labem"), at.main.subheader[0].value
    usti = metriky(at)["Hladina teď"]
    assert usti != decin, "hladina se po přepnutí nezměnila"
    return f"Ústí {usti} cm, Děčín {decin} cm"


def krok_mapa():
    at = nova()
    for pohled in ("Děčín", "Ústí nad Labem", "celé povodí"):
        prvek(at.radio, "Pohled", "mapa_pohled").set_value(pohled).run()
        bez_vyjimky(at)
        # mapa je buď Mapbox (iframe, s tokenem), nebo pydeck (deck_gl_json_chart); druhý iframe je animace
        assert len(at.get("deck_gl_json_chart")) + len(at.get("iframe")) == 2, f"pohled {pohled}: chybí mapa"
        assert any("Co předpověď znamená" in x.value for x in at.markdown), f"pohled {pohled}: chybí věta o rozlivu"
    return "tři pohledy s rozlivem"


def krok_kvalita():
    at = nova()
    for povoden in VALIDACNI:
        prvek(at.selectbox, "Povodeň").set_value(povoden).run()
        bez_vyjimky(at)
        assert not at.warning, f"{povoden}: {at.warning[0].value}"
        assert len(at.dataframe) == 1, f"{povoden}: chybí tabulka metrik"
    return ", ".join(VALIDACNI)


def krok_boris():
    at = nova()
    for h in ("12", "24", "36"):
        prvek(at.selectbox, "Povodeň").set_value(BORIS).run()
        prvek(at.radio, "Předpověď vydaná ... hodin předem").set_value(h).run()
        bez_vyjimky(at)
        assert not at.warning, f"Boris, {h} h: {at.warning[0].value}"
        assert len(at.dataframe) == 1, f"Boris, {h} h: chybí tabulka metrik"
    assert any("Boris 9/2024" in i.value for i in at.info), "chybí poznámka, že jde o testovací část"
    return "záložka Jak dobře to funguje, horizonty 12, 24 a 36 h"


def krok_animace():
    at = nova()
    for povoden in (BORIS, "1/2011"):
        prvek(at.selectbox, "Povodeň", "animace_povoden").set_value(povoden).run()
        bez_vyjimky(at)
