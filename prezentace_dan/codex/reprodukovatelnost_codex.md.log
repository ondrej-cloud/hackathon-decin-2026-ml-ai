"""Lineární regrese (Ridge): odmocnina z průtoků, škálování, Ridge(alpha=1). Cíl je hladina za h hodin."""
import numpy as np
from sklearn.linear_model import Ridge
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import FunctionTransformer, StandardScaler

PARAMETRY = dict(alpha=1.0, odmocnina="jen průtoky", cil="hladina", stanice="všechny")


def odmocnina_prutoku(X):
    """Odmocnina jen na průtoky (_Q_). Na hladině zkazila vrchol povodně 2006 o metr."""
    X = X.copy()
    q = X.columns[X.columns.str.contains("_Q_")]
    X[q] = np.sqrt(X[q])
    return X


def pipeline(alpha):
    return make_pipeline(FunctionTransformer(odmocnina_prutoku, feature_names_out="one-to-one"),
                         StandardScaler(), Ridge(alpha=alpha))


def fit(X, y, cil, horizont, alpha=PARAMETRY["alpha"], zmena=False, sloupce=None):
    """zmena: model se učí y − hladina teď a ta se k předpovědi přičte zpět. sloupce: podmnožina vstupů."""
    sloupce = list(X.columns) if sloupce is None else sloupce
    ted = f"{cil}_H_0"
    model = pipeline(alpha).fit(X[sloupce], y - X[ted] if zmena else y)
    if zmena:
        return lambda X: model.predict(X[sloupce]) + X[ted].to_numpy()
    return lambda X: model.predict(X[sloupce])
"""Neuronová síť (MLP 128-64, alpha=1) na změnu hladiny, odmocnina průtoků, škálované vstupy i cíl."""
import numpy as np
from sklearn.compose import TransformedTargetRegressor
from sklearn.neural_network import MLPRegressor
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import FunctionTransformer, StandardScaler

from data import SPA

PARAMETRY = dict(vrstvy=(128, 64), alpha=1.0, early_stopping=True, max_iter=300, seed=42, cil="změna hladiny")


def odmocnina_prutoku(X):
    return X.assign(**{c: np.sqrt(X[c].clip(lower=0)) for c in X if "_Q_" in c})


def fit(X, y, cil, horizont, vrstvy=PARAMETRY["vrstvy"], alpha=PARAMETRY["alpha"], seed=PARAMETRY["seed"],
        vaha_povodni=1.0):
    sit = MLPRegressor(hidden_layer_sizes=vrstvy, alpha=alpha, early_stopping=True,
                       max_iter=PARAMETRY["max_iter"], random_state=seed)
    m = TransformedTargetRegressor(
        make_pipeline(FunctionTransformer(odmocnina_prutoku), StandardScaler(), sit),
        transformer=StandardScaler(),
    )
    # hodiny nad 1. stupněm povodňové aktivity můžou mít při tréninku větší váhu
    vahy = np.where(y >= SPA[cil][0], vaha_povodni, 1.0)
    m.fit(X, y - X[f"{cil}_H_0"], mlpregressor__sample_weight=vahy)
    return lambda X: X[f"{cil}_H_0"] + m.predict(X)
