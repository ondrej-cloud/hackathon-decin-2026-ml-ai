index 0000000000000000000000000000000000000000..3f1caf199d368d56ff96a6bdfe252de859a0e321
--- /dev/null
+++ b/.repro_audit/check_owned_processes.py
@@ -0,0 +1,46 @@
+import ctypes
+from ctypes import wintypes as w
+from pathlib import Path
+import sys
+
+class Entry(ctypes.Structure):
+    _fields_ = [('size', w.DWORD), ('usage', w.DWORD), ('pid', w.DWORD), ('heap', ctypes.c_size_t),
+                ('module', w.DWORD), ('threads', w.DWORD), ('ppid', w.DWORD), ('priority', w.LONG),
+                ('flags', w.DWORD), ('exe', w.WCHAR * 260)]
+
+k = ctypes.WinDLL('kernel32', use_last_error=True)
+k.CreateToolhelp32Snapshot.argtypes = [w.DWORD, w.DWORD]
+k.CreateToolhelp32Snapshot.restype = w.HANDLE
+k.Process32FirstW.argtypes = [w.HANDLE, ctypes.POINTER(Entry)]
+k.Process32NextW.argtypes = [w.HANDLE, ctypes.POINTER(Entry)]
+k.CloseHandle.argtypes = [w.HANDLE]
+k.OpenProcess.argtypes = [w.DWORD, w.BOOL, w.DWORD]
+k.OpenProcess.restype = w.HANDLE
+k.TerminateProcess.argtypes = [w.HANDLE, w.UINT]
+anchor_file = next((a for a in sys.argv[1:] if a.endswith('.pid')), '.repro_audit/other_models.pid')
+anchor = int(Path(anchor_file).read_text())
+snapshot = k.CreateToolhelp32Snapshot(2, 0)
+e = Entry(); e.size = ctypes.sizeof(e)
+entries = []
+ok = k.Process32FirstW(snapshot, ctypes.byref(e))
+while ok:
+    entries.append((int(e.pid), int(e.ppid), str(e.exe)))
+    ok = k.Process32NextW(snapshot, ctypes.byref(e))
+k.CloseHandle(snapshot)
+owned = {anchor}
+for _ in entries:
+    owned.update(pid for pid, parent, name in entries if parent in owned and name.lower() == 'python.exe')
+for pid, parent, name in entries:
+    if pid in owned:
+        print('OWNED', pid, parent, name, flush=True)
+        if '--stop' in sys.argv:
+            handle = k.OpenProcess(1, False, pid)
+            if not handle:
+                raise OSError(ctypes.get_last_error(), 'Cannot terminate owned process')
+            try:
+                if not k.TerminateProcess(handle, 2):
+                    raise OSError(ctypes.get_last_error(), 'Termination failed')
+                print('STOPPED', pid, flush=True)
+            finally:
+                k.CloseHandle(handle)
+print('CHECK DONE', flush=True)
