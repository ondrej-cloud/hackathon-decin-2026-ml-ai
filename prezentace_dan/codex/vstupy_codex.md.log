  20:         {f"{s}_H_{z}": D[f"{s}_H"].shift(z) for s in CILE for z in ZPOZDENI_H}
  21:         | {f"{s}_Q_{z}": D[f"{s}_Q"].shift(z) for s in CILE | PROTI_PROUDU for z in ZPOZDENI_Q}
  22:     )
  23:     y = D[f"{cil}_H"].shift(-horizont).rename("y")
  24:     ok = X.notna().all(axis=1) & y.notna()
  25:     return X[ok], y[ok]
src/models/ridge.py
   1: """Line�rn� regrese (Ridge): odmocnina z pr�tok�, �k�lov�n�, Ridge(alpha=1). C�l je hladina za h hodin."""
   2: import numpy as np
   3: from sklearn.linear_model import Ridge
   4: from sklearn.pipeline import make_pipeline
   5: from sklearn.preprocessing import FunctionTransformer, StandardScaler
   6: 
   7: PARAMETRY = dict(alpha=1.0, odmocnina="jen pr�toky", cil="hladina", stanice="v�echny")
   8: 
   9: 
  10: def odmocnina_prutoku(X):
  11:     """Odmocnina jen na pr�toky (_Q_). Na hladin� zkazila vrchol povodn� 2006 o metr."""
  12:     X = X.copy()
  13:     q = X.columns[X.columns.str.contains("_Q_")]
  14:     X[q] = np.sqrt(X[q])
  15:     return X
  16: 
  17: 
  18: def pipeline(alpha):
  19:     return make_pipeline(FunctionTransformer(odmocnina_prutoku, feature_names_out="one-to-one"),
  20:                          StandardScaler(), Ridge(alpha=alpha))
  21: 
  22: 
  23: def fit(X, y, cil, horizont, alpha=PARAMETRY["alpha"], zmena=False, sloupce=None):
  24:     """zmena: model se u�� y - hladina te� a ta se k p�edpov�di p�i�te zp�t. sloupce: podmno�ina vstup�."""
  25:     sloupce = list(X.columns) if sloupce is None else sloupce
  26:     ted = f"{cil}_H_0"
  27:     model = pipeline(alpha).fit(X[sloupce], y - X[ted] if zmena else y)
  28:     if zmena:
  29:         return lambda X: model.predict(X[sloupce]) + X[ted].to_numpy()
  30:     return lambda X: model.predict(X[sloupce])
