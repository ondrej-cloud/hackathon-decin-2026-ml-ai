  77:                 propasnuto=propasnuto, plane_poplachy=int(plane))
  78: 
  79: 
  80: def vyhodnot(y, pred, cil, horizont):
  81:     """Metriky jedn� p�edpov�di (stav v cm). y a pred maj� stejn� index, �as vyd�n� p�edpov�di."""
  82:     pred = pd.Series(np.asarray(pred, dtype=float), index=y.index)
  83:     e = (pred - y).abs()
  84:     spa1, spa2, spa3 = SPA[cil]
  85:     okno = pd.Series(False, index=y.index)
  86:     vrcholy = []
  87:     for v in povodne(y, spa2):
