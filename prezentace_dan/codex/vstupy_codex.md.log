  89:         # p�edpov�� vydan� horizont hodin p�ed vrcholem, kladn� = nadhodnotil
  90:         vrcholy.append(pred[v] - y[v])
  91:     out = dict(
  92:         mae=round(e.mean(), 1),
  93:         mae_povodne=round(e[okno].mean(), 1),
  94:         # kladn� = model na povodn�ch soustavn� nadhodnocuje (pozor, nadhodnocov�n� zlep�uje p�edstih)
  95:         bias_povodne=round((pred - y)[okno].mean(), 1),
  96:         mae_nad_1spa=round(e[y >= spa1].mean(), 1),
  97:         chyba_vrcholu=round(float(np.mean(np.abs(vrcholy))), 1),
  98:         vrcholy_o_kolik=[round(float(v)) for v in vrcholy],
  99:         radku=len(y),
 100:     )
 101:     for n, prah in ((2, spa2), (3, spa3)):
 102:         out |= {f"spa{n}_{k}": v for k, v in varovani(y, pred, prah, horizont).items()}
 103:     return out
