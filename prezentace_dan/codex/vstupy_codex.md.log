src/doba_dobehu.py:58:    for cil in CILE:
src/doba_dobehu.py:59:        t = doby(cil).join(doby(cil, jen_velka_voda=True).add_suffix("_nad_300cm"))
src/doba_dobehu.py:60:        t.index = t.index.map(nazvy)
src/doba_dobehu.py:61:        print(f"\ndo {nazvy[cil]}, trénovací část:\n{t.to_string()}")
src/doba_dobehu.py:62:    for cil in CILE:
src/doba_dobehu.py:63:        t = doby_pasma(cil)
src/doba_dobehu.py:64:        print(f"\ndo {nazvy[cil]} podle pásma průtoku v Ústí (m3/s), posun h (korelace, hodin):")
src/doba_dobehu.py:65:        print(t.assign(v=t.posun_h.astype(str) + " (" + t.korelace.astype(str) + ", " + t.hodin.astype(str) + ")")
