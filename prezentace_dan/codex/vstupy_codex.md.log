src/doba_dobehu.py:19:
src/doba_dobehu.py:20:
src/doba_dobehu.py:21:def pasmo(Q_usti):
src/doba_dobehu.py:22:    return np.searchsorted(PASMA, Q_usti, side="right") - 1
src/doba_dobehu.py:23:
src/doba_dobehu.py:24:
src/doba_dobehu.py:25:def posun(c, dQ_stanice):
src/doba_dobehu.py:26:    r = pd.Series({k: c.corr(dQ_stanice.shift(k)) for k in range(MAX_POSUN + 1)})
src/doba_dobehu.py:27:    return int(r.idxmax()), round(r.max(), 2)
src/doba_dobehu.py:28:
src/doba_dobehu.py:29:
src/doba_dobehu.py:30:def doby(cil, jen_velka_voda=False):
src/doba_dobehu.py:31:    D = nacti()
src/doba_dobehu.py:32:    dQ = D.filter(like="_Q").diff(ZMENA_H)
src/doba_dobehu.py:33:    ok = casti(cil, 0) == "train"
src/doba_dobehu.py:34:    if jen_velka_voda:
src/doba_dobehu.py:35:        ok &= D[f"{cil}_H"] >= 300
src/doba_dobehu.py:36:    c = dQ[f"{cil}_Q"].where(ok)
src/doba_dobehu.py:37:    radky = [dict(zip(("stanice", "posun_h", "korelace"), (s, *posun(c, dQ[f"{s}_Q"])))) for s in stanice_nad(cil)]
src/doba_dobehu.py:38:    return pd.DataFrame(radky).set_index("stanice")
src/doba_dobehu.py:39:
src/doba_dobehu.py:40:
src/doba_dobehu.py:41:def doby_pasma(cil):
src/doba_dobehu.py:42:    """Posun a počet trénovacích hodin pro každou stanici a pásmo průtoku v Ústí v čase t."""
src/doba_dobehu.py:43:    D = nacti()
src/doba_dobehu.py:44:    dQ = D.filter(like="_Q").diff(ZMENA_H)
src/doba_dobehu.py:45:    ok = casti(cil, 0) == "train"
src/doba_dobehu.py:46:    p = pd.Series(pasmo(D["usti_Q"].to_numpy()), index=D.index)
src/doba_dobehu.py:47:    radky = []
src/doba_dobehu.py:48:    for s in stanice_nad(cil):
src/doba_dobehu.py:49:        for i, dolni in enumerate(PASMA):
src/doba_dobehu.py:50:            v = ok & (p == i) & dQ[f"{cil}_Q"].notna()
src/doba_dobehu.py:51:            k, r = posun(dQ[f"{cil}_Q"].where(v), dQ[f"{s}_Q"])
src/doba_dobehu.py:52:            radky.append(dict(stanice=s, pasmo=f"od {dolni}", hodin=int(v.sum()), posun_h=k, korelace=r))
src/doba_dobehu.py:53:    return pd.DataFrame(radky)
src/doba_dobehu.py:54:
src/doba_dobehu.py:55:
src/doba_dobehu.py:56:if __name__ == "__main__":
