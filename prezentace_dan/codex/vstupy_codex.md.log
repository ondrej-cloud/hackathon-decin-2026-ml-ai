 306: def g4_cerven_2013():
 307:     F = pd.read_csv(RIDGE / "stanice_vsem/lofo_foldy.csv")
 308:     F = F[(F.horizont == H4) & F.povoden.str.startswith("2013-06")]
 309:     f = F.loc[F.vrchol_cm.idxmax()]  # 2013-06-05, vrchol 1072 cm (druh� �ervnov� vlna 2013-06-26 m� 548 cm)
 310:     oof = {n: pd.read_parquet(RIDGE / f"zlepseni/oof/{n}.parquet") for n in ("ridge_12", "ridge_30", "lgbm_30")}
 311:     a, b, c = oof["ridge_12"], oof["ridge_30"], oof["lgbm_30"]
 312:     for d in (b, c):
 313:         assert len(d) == len(a) and (d.fold.to_numpy() == a.fold.to_numpy()).all() \
 314:             and (d.cas.to_numpy() == a.cas.to_numpy()).all() and (d.y.to_numpy() == a.y.to_numpy()).all()
 315:     m = (a.fold == f.fold).to_numpy()
 316:     cas, y, tym = a.cas[m], a.y.to_numpy()[m], a.pred.to_numpy()[m]
 317:     g3 = 0.5 * b.pred.to_numpy()[m] + 0.5 * c.pred.to_numpy()[m]
 318:     assert cas.min() == pd.Timestamp(f.okno_od) and cas.max() == pd.Timestamp(f.okno_do) and len(cas) == f.radku_okno
 319:     e_tym, e_g3 = float(np.abs(tym - y).mean()), float(np.abs(g3 - y).mean())
 320:     tym_json = next(r for r in nacti_json(RIDGE / "zlepseni/vysledky_C.json") if r["nazev"] == "ridge_12")
 321:     g3_json = next(r for r in nacti_json(RIDGE / "zlepseni/vysledky_G34.json") if r["nazev"].startswith("G3"))
 322:     for co, e, z in (("t�mov� Ridge", e_tym, tym_json), ("G3", e_g3, g3_json)):
 323:         if abs(e - z["po_povodnich"][f.povoden]) > 0.1:
 324:             NESEDI.append(f"G4 {co}: spo��t�no {cislo(e, 2)}, ve vysledky_*.json {z['po_povodnich'][f.povoden]}")
