+import sys; sys.path.insert(0, r"C:\Users\danie\Documents\hackathon-2026-ridge\ridge_dan\zlepseni"); import lofo as L
+from pathlib import Path
+import pyarrow.parquet as pq
+import pandas as pd
+import json
+
+base = Path(__file__).resolve().parent.parent / "stanice_vsem"
+for name in ("predpovedi_ridge_12_None.parquet", "predpovedi_ridge_30_None.parquet", "predpovedi_lgbm_30_42.parquet"):
+    f = pq.ParquetFile(base / name)
+    print(name, f.schema_arrow, "rows", f.metadata.num_rows, flush=True)
+    idx = json.loads(f.schema_arrow.metadata[b"pandas"])["index_columns"][0]
+    d = pd.read_parquet(base / name, filters=[(idx, "<", L.KONEC)])
+    print(d.head(2).to_string(), d.dtypes.to_dict(), flush=True)
+    for c in d.columns.difference(["y", "pred"]):
+        print(c, d[c].unique().tolist(), flush=True)
diff --git a/ridge_dan/smesi/ram_G.py b/ridge_dan/smesi/ram_G.py
new file mode 100644
index 0000000000000000000000000000000000000000..61dd13116166bf4c2e65847421b2f4e42be458fc
--- /dev/null
+++ b/ridge_dan/smesi/ram_G.py
@@ -0,0 +1,10 @@
+import sys; sys.path.insert(0, r"C:\Users\danie\Documents\hackathon-2026-ridge\ridge_dan\zlepseni"); import lofo as L
+import ctypes
+import os
+from experiment_G import log
+class MemoryStatus(ctypes.Structure):
+    _fields_ = [("length", ctypes.c_ulong), ("load", ctypes.c_ulong)] + [(n, ctypes.c_ulonglong) for n in ("total_phys", "avail_phys", "total_page", "avail_page", "total_virt", "avail_virt", "extended")]
+s = MemoryStatus()
+s.length = ctypes.sizeof(s)
+assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(s))
+log(f"Diagnostika RAM: celkem={s.total_phys / 1024**2:.0f} MB, volno={s.avail_phys / 1024**2:.0f} MB; diagnostický PID={os.getpid()}.")

