"""Společné rozdělení na train / val / test a vyhodnocení. Nikdo ho nemění jen pro svůj model.

- train: 2006–2018 bez validačních povodní a 20 dní kolem nich
- val: 4 vynechané povodně (16 dní před vrcholem až 5 dní po něm) a klidné roky 2019–2020
- test: 2021–2025 (povodně 12/2023 a 9/2024), pouští se jednou na konci, rozhoduje Ondra.
  Finální model se pak trénuje na všem do konce 2020.
"""
import numpy as np
import pandas as pd

from data import SPA, nacti
from features import NEJSTARSI

POVODNE_VAL = ["2006-04-03", "2009-03-07", "2010-09-29", "2011-01-17"]
KLID_VAL = ("2019-01-01", "2020-12-31")
TEST_OD = "2021-01-01"
OKNO_VAL, PRED, PO, VYNECHAT = pd.Timedelta(days=16), pd.Timedelta(days=7), pd.Timedelta(days=5), pd.Timedelta(days=20)


def povodne(H, prah):
    """Vrcholy povodní, kdy stav přešel práh (víc než 7 dní od sebe = různé povodně)."""
    s = H[H >= prah]
    useky = []
    for t in s.index:
        if useky and t - useky[-1][1] <= pd.Timedelta(days=7):
            useky[-1][1] = t
        else:
            useky.append([t, t])
    return [H[a:b].idxmax() for a, b in useky]


def casti(cil, horizont, finalni=False):
    """Pro každou hodinu 'train', 'val', 'test' nebo '' (nepoužít)."""
    H = nacti()[f"{cil}_H"]
    c = pd.Series("train", index=H.index)
    if not finalni:
        vrcholy = [H[pd.Timestamp(d, tz="UTC") - pd.Timedelta(days=3):][:144].idxmax() for d in POVODNE_VAL]
        for v in vrcholy:
            c[v - OKNO_VAL - VYNECHAT: v + PO + VYNECHAT] = ""
        c[KLID_VAL[0]:KLID_VAL[1]] = "val"
        for v in vrcholy:
            c[v - OKNO_VAL: v + PO] = "val"
    c[TEST_OD:] = "test"
    # vstupy (až 36 h zpět) i cíl (t + horizont) musí ležet ve stejné části, jinak řádek vynecháme
    ok = (c == c.shift(-horizont)) & (c == c.shift(NEJSTARSI))
    return c.where(ok, "")


def varovani(y, pred, prah, horizont):
    """Varování před překročením prahu. y a pred: index je čas vydání t, hodnota je stav v t + horizont.

    Předstih je nejvýš horizont: dřívější varování znamená, že model ohlásil povodeň dřív, než mohla přijít.
    Propásnutá povodeň se do průměrného předstihu počítá jako 0.
    """
    hodiny = pd.date_range(y.index.min(), y.index.max(), freq="h")
    y, pred = y.reindex(hodiny), pred.reindex(hodiny)
    alarm = (pred >= prah).astype(int)
    # začátek povodně: skutečný stav přejde práh a 4 dny předtím byl změřený a pod ním
    pod = (y < prah).astype(float).where(y.notna())
    zacatky = hodiny[(y >= prah) & (pod.shift(1).rolling(96, min_periods=96).min() == 1)]
    predstih, propasnuto = [], 0
    for t in zacatky:
        vydane = alarm[t - pd.Timedelta(hours=48): t + pd.Timedelta(hours=horizont - 1)]
        if vydane.any():
            predstih.append(min(horizont, horizont - (vydane.idxmax() - t) / pd.Timedelta(hours=1)))
        else:
            predstih.append(0.0)
            propasnuto += 1
    # planý poplach: souvislý úsek varování (mezery do 6 h spojíme), během kterého ani den po něm
    # skutečný stav práh nepřekročil (y[t] je stav v t + horizont, proto od s - horizont)
    a = alarm.rolling(7, min_periods=1).max()
    starty = hodiny[(a == 1) & (a.shift(1, fill_value=0) == 0)]
    konce = hodiny[(a == 1) & (a.shift(-1, fill_value=0) == 0)]
    plane = sum(not (y[s - pd.Timedelta(hours=horizont): e + pd.Timedelta(hours=24)] >= prah).any()
                for s, e in zip(starty, konce))
    return dict(povodni=len(zacatky), predstih_h=round(float(np.mean(predstih)), 1) if predstih else None,
                propasnuto=propasnuto, plane_poplachy=int(plane))


def vyhodnot(y, pred, cil, horizont):
    """Metriky jedné předpovědi (stav v cm). y a pred mají stejný index, čas vydání předpovědi."""
    pred = pd.Series(np.asarray(pred, dtype=float), index=y.index)
    e = (pred - y).abs()
    spa1, spa2, spa3 = SPA[cil]
    okno = pd.Series(False, index=y.index)
    vrcholy = []
    for v in povodne(y, spa2):
        okno[v - PRED: v + PO] = True
        # předpověď vydaná horizont hodin před vrcholem, kladná = nadhodnotil
        vrcholy.append(pred[v] - y[v])
    out = dict(
        mae=round(e.mean(), 1),
        mae_povodne=round(e[okno].mean(), 1),
        # kladná = model na povodních soustavně nadhodnocuje (pozor, nadhodnocování zlepšuje předstih)
        bias_povodne=round((pred - y)[okno].mean(), 1),
        mae_nad_1spa=round(e[y >= spa1].mean(), 1),
        chyba_vrcholu=round(float(np.mean(np.abs(vrcholy))), 1),
        vrcholy_o_kolik=[round(float(v)) for v in vrcholy],
        radku=len(y),
    )
    for n, prah in ((2, spa2), (3, spa3)):
        out |= {f"spa{n}_{k}": v for k, v in varovani(y, pred, prah, horizont).items()}
    return out
"""Vlastní hodinová tabulka 2006–2025 v UTC z otevřených dat ČHMÚ (CC BY 4.0): stavy a průtoky + denní srážky.

python data_ridge.py    postaví tabulka/labe_ridge.parquet (není v Gitu) z cache/ (stahni_hydro.py, stahni_srazky.py)

Sloupce:
- <stanice>_H stav v cm (jen Děčín a Ústí), <stanice>_Q průtok v m3/s, čas měření v UTC (ČHMÚ dává 'Z')
- sra_<povodí>: průměrný denní úhrn srážek v povodí za poslední UKONČENÝ měřicí den, jak by byl známý v čase t.
  Denní hodnota s razítkem D 06:00Z je součet hodinových srážek D 07:00Z … D+1 06:00Z (ověřeno na hodinových
  datech 2019, overeni_srazek()). Do tabulky proto vstupuje až od D+1 07:00 UTC (hodina rezervy) a platí 24 h.
"""
import glob
import json
import re
from functools import cache
from pathlib import Path

import numpy as np
import pandas as pd

from stanice import CILE, HYDRO

ZDE = Path(__file__).resolve().parent
CACHE = ZDE / "cache"
SOUBOR = ZDE / "tabulka/labe_ridge.parquet"
OD, DO = "2006-01-01", "2025-12-31"
DOSTUPNE_PO = pd.Timedelta(hours=25)  # od razítka denního úhrnu do chvíle, kdy ho smíme použít


def hydro():
    keys = {dbc: k for dbc, (k, _) in HYDRO.items()}
    parts = {}
    for f in glob.glob(str(CACHE / "hydrology/historical/data/hourly/H_0-203-1-*_HQ_*.json")):
        dbc, rok = re.search(r"1-(\d+)_HQ_(\d{4})", f).groups()
        if dbc not in keys or not OD[:4] <= rok <= DO[:4]:
            continue
        for ts in json.loads(Path(f).read_text(encoding="utf-8"))["tsList"]:
            veliciny = "HQ" if keys[dbc] in CILE else "Q"
            if ts["tsConID"][0] in veliciny:
                v = pd.DataFrame(ts["tsData"]["data"]["values"], columns=["t", "v"])
                parts.setdefault(f"{keys[dbc]}_{ts['tsConID'][0]}", []).append(v)
    D = pd.DataFrame({
        k: pd.concat(v).assign(t=lambda x: pd.to_datetime(x.t, utc=True)).drop_duplicates("t").set_index("t").v
        for k, v in parts.items()
    }).sort_index()
    D = D.reindex(pd.date_range(OD, f"{DO} 23:00", freq="h", tz="UTC"))
    # stejná oprava jako v týmové tabulce: v Děčíně stav až 1 019 cm při průtoku kolem 120 m3/s (led), nebereme
    D.loc["2006-02-05":"2006-02-08 09:00", "decin_H"] = np.nan
    poradi = [f"{k}_{v}" for k in CILE for v in "HQ"] + [f"{k}_Q" for k, _ in HYDRO.values() if k not in CILE]
    return D[[c for c in poradi if c in D]]


def denni(slozka, prvek, wsi):
    """Denní hodnoty prvku po stanicích (index = razítko ČHMÚ v UTC), sloupce wsi. Chybějící soubor přeskočí."""
    out = {}
    for w in wsi:
        f = CACHE / f"meteorology/climate/historical_csv/data/daily/{slozka}/dly-{w}-{prvek}.csv"
        if not f.exists():
            continue
        d = pd.read_csv(f)
        d = d[d.ELEMENT == prvek]
        out[w] = d.assign(DT=pd.to_datetime(d.DT, utc=True)).drop_duplicates("DT").set_index("DT").VALUE
    return pd.DataFrame(out).sort_index()["2005-12-01":]


def teplota_terminy(skupiny, hodiny):
    """Teplota z termínů 06, 13 a 20 UTC (okamžitá měření): průměr posledních tří termínů (≈ posledních 24 h),
    použitelný hodinu po posledním z nich. Denní průměr AVG (razítko D 00:00Z) se nepoužívá."""
    out = {}
    for s in sorted(skupiny.unique()):
        rady = []
        for w in skupiny.index[skupiny == s]:
            f = CACHE / f"meteorology/climate/historical_csv/data/daily/temperature/dly-{w}-T.csv"
            if not f.exists():
                continue
            d = pd.read_csv(f)
            d = d[(d.ELEMENT == "T") & d.TIMEFUNC.isin(["06:00", "13:00", "20:00"])]
            d = d.assign(DT=pd.to_datetime(d.DT, utc=True)).drop_duplicates("DT").set_index("DT").VALUE.sort_index()
            d = d["2005-12-01":]
            # tři po sobě jdoucí termíny musí ležet do 24 h, jinak je v řadě díra
            ok = (d.index.to_series().diff(2) <= pd.Timedelta(hours=24)).to_numpy()
            d = d.rolling(3).mean().where(ok)
            d.index = d.index + pd.Timedelta(hours=1)
            rady.append(d.rename(w))
        if rady:
            out[f"tep_{s}"] = pd.concat(rady, axis=1, sort=True).mean(axis=1).reindex(hodiny, method="ffill", limit=11)
    out = pd.DataFrame(out, index=hodiny)
    # vybrané teploměry Labe pod Mělníkem měří jen do roku 2005, Jizera až od 2015: teplota je plošně hladká,
    # vezme se ze sousedního povodí (Bílina, střední Labe)
    for s, soused in (("labe_dolni", "bilina"), ("jizera", "labe_stredni")):
        out[f"tep_{s}"] = out.get(f"tep_{s}", pd.Series(np.nan, index=hodiny)).combine_first(out[f"tep_{soused}"])
    return out


def srazky_denni():
    S = pd.read_csv(ZDE / "srazkove_stanice.csv")
    return denni("precipitation", "SRA", S.wsi), S.set_index("wsi").skupina


def po_povodich(dny, skupiny, hodiny, predpona, posun):
    """Průměr přes stanice povodí, posunutý o `posun` od razítka (kdy je hodnota známá), podržený 24 h."""
    out = {}
    for s in sorted(skupiny.unique()):
        sl = [w for w in skupiny.index[skupiny == s] if w in dny]
        if not sl:
            continue
        d = dny[sl].mean(axis=1)
        d.index = d.index + posun
        out[f"{predpona}_{s}"] = d.reindex(hodiny, method="ffill", limit=23)
    return pd.DataFrame(out, index=hodiny)


def srazky_hodinove(denni_sra, skupiny, hodiny):
    return po_povodich(denni_sra, skupiny, hodiny, "sra", DOSTUPNE_PO)


def overeni_srazek():
    """Průměrný rozdíl denního úhrnu a součtu hodinových pro různé začátky intervalu (Ústí-Kočkov, 05–08/2019)."""
    fs = sorted(glob.glob(str(CACHE / "meteorology/climate/historical_csv/data/1hour/precipitation/2019/*11502*")))
    h = pd.concat([pd.read_csv(f) for f in fs]).assign(DT=lambda x: pd.to_datetime(x.DT, utc=True)).set_index("DT").VALUE
    d = pd.read_csv(CACHE / "meteorology/climate/historical_csv/data/daily/precipitation/dly-0-20000-0-11502-SRA.csv")
    d = d[d.ELEMENT == "SRA"].assign(DT=lambda x: pd.to_datetime(x.DT, utc=True)).set_index("DT").VALUE
    d = d["2019-05-03":"2019-08-28"]
    c = h.cumsum()
    out = {}
    for p in range(-26, 4):
        s = c.reindex(d.index + pd.Timedelta(hours=24 + p)).to_numpy() - c.reindex(d.index + pd.Timedelta(hours=p)).to_numpy()
        out[p] = round(float(np.nanmean(np.abs(s - d.to_numpy()))), 3)
    return pd.Series(out, name="mm")


def postav():
    D = hydro()
    sra, skupiny = srazky_denni()
    R = srazky_hodinove(sra, skupiny, D.index)
    # výška sněhu: pozorování v 06:00Z, bereme konzervativně až od dalšího dne 07:00Z jako srážky
    snih = po_povodich(denni("snow", "SCE", skupiny.index), skupiny, D.index, "sce", DOSTUPNE_PO)
    teplota = teplota_terminy(skupiny, D.index)
    T = pd.concat([D, R, snih, teplota], axis=1).astype("float32").rename_axis("cas")
    SOUBOR.parent.mkdir(exist_ok=True)
    T.to_parquet(SOUBOR)
    return T


@cache
def nacti():
    return pd.read_parquet(SOUBOR).astype("float64")


if __name__ == "__main__":
    T = postav()
    print(f"{len(T)} hodin, {T.shape[1]} sloupců, {SOUBOR.stat().st_size / 1e6:.1f} MB")
    print("chybí (hodin):", T.isna().sum()[lambda s: s > 0].to_dict())
    o = overeni_srazek()
    print("denní úhrn vs. hodinové, posun začátku intervalu proti razítku (h) → průměrný rozdíl mm:")
    print(o[o.index >= -3].to_string())
"""Společný základ pro srovnání „beze změny“ vs „+ 18 nových stanic“ u všech čtyř týmových modelů.

Týmové vstupy beze změny (src/features.py nad Ondrovou tabulkou), k nim se podle času UTC připojí průtoky 18 nových
stanic z vlastní tabulky (ridge_dan/tabulka/labe_ridge.parquet) se stejnými zpožděními jako ostatní průtoky.
Rozdělení a metriky jsou týmové (src/evaluate.py). Obě varianty se hodnotí na stejných řádcích.
"""
import os
import sys
from pathlib import Path

os.environ.setdefault("OPENBLAS_NUM_THREADS", "4")

ZDE = Path(__file__).resolve().parent
RIDGE_DAN = ZDE.parent
sys.path[:0] = [str(RIDGE_DAN.parent / "src"), str(RIDGE_DAN)]

import numpy as np  # noqa: E402
import pandas as pd  # noqa: E402

import data_ridge  # noqa: E402
import hodnoceni as Hd  # noqa: E402
from evaluate import casti, povodne, vyhodnot  # noqa: E402
from features import ZPOZDENI_Q, tabulka  # noqa: E402
from stanice import HYDRO, TYM  # noqa: E402

NOVE = [k for k, _ in HYDRO.values() if k not in TYM]
assert len(NOVE) == 18
# Ploučnice a Bílina se vlévají pod Ústím, do Ústí z nich nic neteče (týmové Ridge a síť ale dávají všechny stanice
# oběma cílům, i Děčín Ústí; u nich se nové přidávají taky všechny, u modelů s dobou doběhu jen ty nad cílem)
POD_USTIM = ["benesov_pl", "struznice", "ceska_lipa", "trmice"]
VSE = [(c, h) for c in ("decin", "usti") for h in (12, 24, 36)]


def nove_sloupce():
    T = data_ridge.nacti()
    return pd.DataFrame({f"{s}_Q_{z}": T[f"{s}_Q"].shift(z) for s in NOVE for z in ZPOZDENI_Q})


def data(cil, horizont):
    """X (týmových 98 sloupců), Xn (98 + 126 nových), y, c; všechno na STEJNÝCH řádcích."""
    X, y = tabulka(cil, horizont)
    N = nove_sloupce().reindex(X.index)
    ok = N.notna().all(axis=1)
    X, y, N = X[ok], y[ok], N[ok]
    c = casti(cil, horizont).reindex(X.index)
    return X, pd.concat([X, N], axis=1), y, c


def val_metriky(y, pred, cil, horizont, H=None):
    """Týmové metriky (vyhodnot) a pro Děčín navíc vzestup, začátek vzestupu, klid a 1. SPA (hodnoceni.metriky)."""
    pred = pd.Series(np.asarray(pred, dtype=float), index=y.index)
    m = vyhodnot(y, pred, cil, horizont)
    if H is not None:
        m = Hd.metriky(y, pred, H, cil, horizont)
    return m


def cv_predikce(fit, X, y, c, cil, horizont):
    """Časová CV v tréninku (bloky let s mezerou 10 dní, hodnoceni.bloky_cv): předpovědi pro tréninkové řádky."""
    tr = c == "train"
    Xt, yt = X[tr], y[tr]
    pred = pd.Series(np.nan, index=yt.index)
    for _, f_tr, f_drz in Hd.bloky_cv(Xt.index):
        predict = fit(Xt[f_tr], yt[f_tr], cil, horizont)
        pred[f_drz] = np.asarray(predict(Xt[f_drz]), dtype=float)
    return yt, pred


def cv_skore(yt, pred, Xt_ted):
    """Stejná čísla jako ridge_dan/pokus.py: průměr přes povodně nad 400 cm (okno 7 dní před až 5 po vrcholu),
    velké povodně nad 490 cm, rychlé stoupání; navíc přestřelení v oknech povodní (pred − y): průměr největších
    přestřelení jednotlivých povodní, 95. percentil přes všechny hodiny oken a největší přestřelení vůbec."""
    e = (pred - yt).abs().to_numpy()
    rozdil = (pred - yt).to_numpy()
    ud, velke, prestrel, v_oknech = {}, [], [], []
    for _, _, f_drz in Hd.bloky_cv(yt.index):
        yy = yt[f_drz]
        for v in povodne(yy, 400):
            pos = np.flatnonzero(np.asarray(f_drz) & (yt.index >= v - Hd.E.PRED) & (yt.index <= v + Hd.E.PO))
            ud[f"{v:%Y-%m-%d}"] = e[pos].mean()
            prestrel.append(rozdil[pos].max())
            v_oknech.append(rozdil[pos])
            if yt.to_numpy()[pos].max() >= 490:
                velke.append(e[pos].mean())
    vz = ((yt - Xt_ted) >= 50).to_numpy()
    return dict(cv_povodne=float(np.mean(list(ud.values()))), cv_velke=float(np.mean(velke)),
                cv_vzestup=float(e[vz].mean()), cv_bias_vzestup=float(rozdil[vz].mean()), cv_mae=float(e.mean()),
                cv_prumer_max_prestreleni=float(np.mean(prestrel)),
                cv_p95_prestreleni=float(np.percentile(np.concatenate(v_oknech), 95)),
                cv_max_prestreleni=float(np.max(prestrel)), cv_udalosti={k: round(float(v), 2) for k, v in ud.items()})


def povoden_2006(y, pred, H):
    """Jarní povodeň 2006 (tání) v Děčíně: chyba v okně, chyba na stoupání a největší přestřelení na stoupání."""
    pred = pd.Series(np.asarray(pred, dtype=float), index=y.index)
    v = povodne(y, 490)[0]
    assert f"{v:%Y-%m}" == "2006-04", v
    okno = (y.index >= v - Hd.E.PRED) & (y.index <= v + Hd.E.PO)
    stoupa = okno & (y.index < v - pd.Timedelta(hours=24))
    d = (pred - y)
    return dict(mae_2006=round(float(d[okno].abs().mean()), 1), mae_2006_stoupani=round(float(d[stoupa].abs().mean()), 1),
                max_prestreleni_2006=round(float(d[stoupa].max()), 1), bias_2006=round(float(d[okno].mean()), 1))
