+    log("Výstupy uzavřeny z již spočtených metrik, bez nového výpočtu.")
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--final", action="store_true")
+    p.add_argument("--uzavri", action="store_true")
