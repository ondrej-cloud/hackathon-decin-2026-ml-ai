@@ -0,0 +1,172 @@
+import sys; sys.path.insert(0, r"C:\Users\danie\Documents\hackathon-2026-ridge\ridge_dan\zlepseni"); import lofo as L
+
+import argparse
+import json
+from datetime import datetime
+from pathlib import Path
+import numpy as np
+import pandas as pd
+from experiment_G import ZDE, RIDGE, GRID, cti_pred_2021, validace_pevna, zapis_json, vahy_zapis, cekej_ram, log
+
+SIT = Path(r"C:\Users\danie\Documents\hackathon-2026-sit\sit_dan\lofo")
+LGBM = RIDGE / "zlepseni" / "oof" / "lgbm_30.parquet"
+
+
+def cti_oof(cesta, zaklad):
+    if cesta.suffix.lower() == ".parquet":
+        d = pd.read_parquet(cesta, filters=[("cas", "<", L.KONEC)])
+    else:
+        d = pd.read_csv(cesta)
+    if "cas" not in d and d.index.name == "cas":
+        d = d.reset_index()
+    d = d.rename(columns={"predpoved": "pred", "skutecnost": "y"})
+    if "varianta" in d:
+        # Volba předem podle identity týmového modelu, nikoli podle výsledku.
+        d = d[d.varianta == "beze_zmeny"]
+    assert {"fold", "cas", "y", "pred"} <= set(d.columns), list(d.columns)
+    if "horizont" in d:
+        d = d[d.horizont == 24]
+    if "cil" in d:
+        d = d[d.cil == "decin"]
+    if "seed" in d:
+        d = d[d.seed == 42]
+    d["cas"] = pd.to_datetime(d.cas, utc=True)
+    assert (d.cas < L.KONEC).all()
+    assert set(d.fold.unique()) == set(range(22)), d.fold.unique()
+    out = []
+    for k in range(22):
+        zdroj = d[d.fold == k]
+        refer = zaklad[zaklad.fold == k]
+        assert zdroj.cas.is_monotonic_increasing and zdroj.cas.is_unique
+        pd.testing.assert_index_equal(pd.DatetimeIndex(zdroj.cas).as_unit("ns"), pd.DatetimeIndex(refer.cas).as_unit("ns"), check_names=False)
+        np.testing.assert_allclose(zdroj.y.to_numpy(), refer.y.to_numpy(), atol=1e-8, rtol=0)
+        assert np.isfinite(zdroj.pred.to_numpy()).all()
+        out.append(zdroj.pred.to_numpy(dtype=float))
+    assert len(d) == len(zaklad)
+    return out
+
+
+def sestav(final=False):
+    if cekej_ram() is None:
+        raise RuntimeError("Není volných 1500 MB RAM.")
+    vysl = json.loads((ZDE / "vysledky_G.json").read_text(encoding="utf-8"))
+    # Při opakování zachovat jen základní výsledky, ostatní vždy z aktuálního zdroje.
+    vysl = [r for r in vysl if r["nazev"] in ("G1", "G2")]
+    refs = json.loads((ZDE / "reference_G.json").read_text(encoding="utf-8"))
+    d = pd.read_parquet(ZDE / "predpovedi_G.parquet")
+    assert (d.cas + pd.Timedelta(hours=24) < L.KONEC).all()
+    p12 = [d[d.fold == k].ridge12.to_numpy() for k in range(22)]
+    p30 = [d[d.fold == k].ridge30.to_numpy() for k in range(22)]
+    pov = L.povodne_lofo(24)
+    for k in range(22):
+        expected = L.zaklad(24)[1].index[pov[k]["okno"]]
+        pd.testing.assert_index_equal(pd.DatetimeIndex(d[d.fold == k].cas).as_unit("ns"), expected.as_unit("ns"), check_names=False)
+    refs["Ridge12"]["validace"] = validace_pevna("predpovedi_ridge_12_None.parquet")
+    refs["Ridge30"]["validace"] = validace_pevna("predpovedi_ridge_30_None.parquet")
+    zapis_json("reference_G.json", refs)
+    vysl[0]["validace"] = validace_pevna("predpovedi_ridge_12_None.parquet", "predpovedi_ridge_30_None.parquet")
+    vysl[0]["validace_zdroj"] = "Hotové týmové val předpovědi, shodný časový index a y; evaluate.vyhodnot, Děčín +24 h."
+    val_g3 = validace_pevna("predpovedi_ridge_30_None.parquet", "predpovedi_lgbm_30_42.parquet")
+
+    chyby = []
+    def pridej(jmeno, popis, pred, vahy, val=None, **navic):
+        vysl.append(dict(nazev=jmeno, popis=popis, skore=L.skore(pred, 24, zaklad_pred=p12),
+                         validace=val, vybrane_vahy=vahy, **navic))
+    if LGBM.is_file():
+        try:
+            pg = cti_oof(LGBM, d)
+            g3 = [(a + b) / 2 for a, b in zip(p30, pg)]
+            pridej("G3", "0,5 Ridge30 + 0,5 LightGBM30 (seed 42); pevná váha.", g3, 0.5,
+                   val_g3, zdroj=str(LGBM))
+            g4, w4 = [], []
+            for k in range(22):
+                errs = []
+                for j in range(22):
+                    if j == k:
+                        continue
+                    yy = d[d.fold == j].y.to_numpy()
+                    errs.append(np.abs(GRID[:, None] * p30[j] + (1 - GRID[:, None]) * pg[j] - yy).mean(axis=1))
+                w = float(GRID[np.argmin(np.mean(errs, axis=0))])
+                w4.append(w)
+                g4.append(w * p30[k] + (1 - w) * pg[k])
+            pridej("G4", "w Ridge30 + (1−w) LightGBM30; POUZE PŘIBLIŽNĚ vnořené: váha dle průměru MAE ostatních 21 LOFO oken, jejich modely viděly k v tréninku; mřížka 0:0,1:1, shoda → nižší w.",
+                   g4, vahy_zapis(w4, pov), vnoreni="priblizne",
+                   vyhrada="Pole skore.splnuje je doslovný výstup L.skore; platí pouze s výhradou úniku při volbě vah, nejde o striktně vnořený důkaz.",
+                   poznamka_validace="Val pro laděné směsi zadání nevyžaduje; nehodnoceno.")
+            for k in range(22):
+                ix = d.index[d.fold == k]
+                d.loc[ix, "lgbm30"] = pg[k]
+                d.loc[ix, "G3"] = g3[k]
+                d.loc[ix, "G4"] = g4[k]
+        except Exception as exc:
+            chyby.append(f"LightGBM soubor existuje, ale neprošel ověřením: {type(exc).__name__}: {exc}")
+    else:
+        chyby.append("LOFO LightGBM30 zatím nedodáno.")
+
+    sit_nalez = None
+    if SIT.is_dir():
+        for cesta in sorted(SIT.rglob("*")):
+            if not cesta.is_file() or cesta.suffix.lower() not in (".parquet", ".csv"):
+                continue
+            # G5 smí použít jen soubor dodaný do místního termínu 00:10.
+            if datetime.fromtimestamp(cesta.stat().st_mtime) > datetime(2026, 10, 24, 0, 10):
+                continue
+            try:
+                ps = cti_oof(cesta, d)
+                sit_nalez = cesta
+                g5 = [(a + b) / 2 for a, b in zip(p30, ps)]
+                pridej("G5", "0,5 Ridge30 + 0,5 týmová síť beze_zmeny (12 stanic, seed 42); pevná váha; identita varianty určena předem bez výběru dle skóre; ověřeno všech 22 foldů, časů a cílů proti týmovému manifestu.", g5, 0.5,
+                       zdroj=str(cesta), poznamka_validace="Hotové validační předpovědi sítě nebyly zadány.")
+                for k in range(22):
+                    ix = d.index[d.fold == k]
+                    d.loc[ix, "sit"] = ps[k]
+                    d.loc[ix, "G5"] = g5[k]
+                break
+            except Exception as exc:
+                chyby.append(f"Síť {cesta.name}: nelze ověřit ({type(exc).__name__}: {exc}).")
+    if sit_nalez is None:
+        chyby.append(f"V {SIT} nebyly nalezeny použitelné LOFO předpovědi sítě ({datetime.now():%Y-%m-%d %H:%M:%S}).")
+    hotove = {r["nazev"] for r in vysl}
+    for jmeno in ("G3", "G4", "G5"):
+        if jmeno not in hotove:
+            vysl.append(dict(nazev=jmeno, popis="Nespočteno: chybí ověřené LOFO předpovědi externího modelu.",
+                             skore=None, validace=val_g3 if jmeno == "G3" else None, vybrane_vahy=0.5 if jmeno in ("G3", "G5") else None,
+                             duvod="; ".join(chyby), stav="nedostupne" if final else "ceka"))
+    zapis_json("vysledky_G.json", vysl)
+    d.to_parquet(ZDE / "predpovedi_G.parquet", index=False)
+    zapis_json("stav_G.json", dict(cas=datetime.now().isoformat(), finalni=final, chybi=chyby,
+        protokol="2006–2020; před tvorbou vstupů filtr v Parquet; 2021–2025 nepoužito; L.skore beze změn.",
+        ram="L.cekej_na_ram(1500), původní čekání; CIM dotaz lokálně nahrazen GlobalMemoryStatusEx kvůli sandboxu.",
+        casovy_limit="35 minut od zahájení 23:22, konec nejpozději 23:57; dříve než dodací termíny 00:10/00:12."))
+    radky = ["Děčín +24 h; 22 LOFO povodní 2006–2020, test 2021–2025 nepoužit; jednotky cm.",
+             "G1/G3/G5 pevně 0,5; G2 striktně vnořené bez mezer k i j; váhy po foldech jsou v JSON.",
+             "", "| Varianta | LOFO | rozdíl | zlepšeno z 22 | nejhorší zhoršení | splňuje | val |", "|---|---:|---:|---:|---:|---|---:|"]
+    for name in ("Ridge12", "Ridge30"):
+        s = refs[name]
+        radky.append(f"| {name} | {s['lofo']:.2f} | {s.get('rozdil', 0):+.2f} | {s.get('zlepseno', '—')} | {s.get('nejhorsi_zhorseni', 0):.1f} | {'ano' if s.get('splnuje') else '—' if name == 'Ridge12' else 'ne'} | {s['validace']['mae_povodne']:.1f} |")
+    for r in vysl:
+        s = r["skore"]
+        if s is None:
+            val = r["validace"]["mae_povodne"] if r["validace"] else "—"
+            radky.append(f"| {r['nazev']} | nedodáno | — | — | — | nehodnoceno | {val} |")
+            continue
+        val = r["validace"]["mae_povodne"] if r["validace"] else None
+        radky.append(f"| {r['nazev']} | {s['lofo']:.2f} | {s['rozdil']:+.2f} | {s['zlepseno']} | {s['nejhorsi_zhorseni']:.1f} | {'ano' if s['splnuje'] else 'ne'}{'*' if r['nazev'] == 'G4' else ''} | {val if val is not None else '—'} |")
+    radky.append("*G4 je pouze přibližně vnořená: modely ostatních foldů viděly vlastní povodeň k; splnění pravidla platí s touto výhradou.")
+    if chyby:
+        radky.append("Chybí externí LOFO: " + "; ".join(chyby) + (" Limit 35 minut končí před 00:10/00:12, proto nelze čekat až do těchto termínů." if final else " Čekání pokračuje v limitu 35 minut."))
+    else:
+        radky.append("Val = mae_povodne z evaluate.vyhodnot nad hotovými týmovými val předpověďmi; u G2/G4 se nepožaduje.")
+    dobre = [r["nazev"] for r in vysl if r["skore"] and r["skore"]["splnuje"] and r["nazev"] != "G4"]
+    radky.append("Závěr: " + (", ".join(dobre) + " splňuje stanovené pravidlo." if dobre else "Žádná dostupná striktně hodnocená směs nesplňuje celé stanovené pravidlo."))
+    assert 5 <= len(radky) <= 15, len(radky)
+    (ZDE / "pokus_G.md").write_text("\n".join(radky) + "\n", encoding="utf-8")
+    log(f"Doplnění: hotovo {sorted(hotove)}; chybí {chyby}")
+    print("\n".join(radky), flush=True)
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("--final", action="store_true")
+    args = p.parse_args()
+    sestav(args.final)
diff --git a/ridge_dan/smesi/experiment_G.py b/ridge_dan/smesi/experiment_G.py
new file mode 100644
index 0000000000000000000000000000000000000000..2fb95c0e9f3837db5828cace144a1258c3e43d94
--- /dev/null
+++ b/ridge_dan/smesi/experiment_G.py
@@ -0,0 +1,184 @@
+import sys; sys.path.insert(0, r"C:\Users\danie\Documents\hackathon-2026-ridge\ridge_dan\zlepseni"); import lofo as L
+
+import gc
+import ctypes
+import json
+import subprocess
+import time
+from datetime import datetime
+from functools import cache
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pyarrow.parquet as pq
+import data
+import features
+import evaluate
+
+ZDE = Path(__file__).resolve().parent
+RIDGE = ZDE.parent
+GRID = np.arange(11) / 10
+
+
+def zapis_json(jmeno, obsah):
+    (ZDE / jmeno).write_text(json.dumps(obsah, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
+
+
+def log(zprava):
+    s = f"{datetime.now():%H:%M:%S} {zprava}"
+    print(s, flush=True)
+    with (ZDE / "prubeh_G.log").open("a", encoding="utf-8") as f:
+        f.write(s + "\n")
+
+
+def cekej_ram():
+    # Sandbox nepovoluje CIM. Jen během původní čekací funkce nahradíme
+    # její jediný dotaz na FreePhysicalMemory ekvivalentním Windows API.
+    class MemoryStatus(ctypes.Structure):
+        _fields_ = [("length", ctypes.c_ulong), ("load", ctypes.c_ulong)] + [
+            (name, ctypes.c_ulonglong) for name in
+            ("total_phys", "avail_phys", "total_page", "avail_page", "total_virt", "avail_virt", "extended")]
+    original = subprocess.run
+    def dotaz(args, **kwargs):
+        if isinstance(args, list) and args[:3] == ["powershell", "-NoProfile", "-Command"] and "FreePhysicalMemory" in args[3]:
+            if datetime.now() >= datetime(2026, 10, 23, 23, 56):
+                raise TimeoutError("Konec čekání kvůli celkovému limitu 35 minut.")
+            status = MemoryStatus()
+            status.length = ctypes.sizeof(status)
+            if not ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)):
+                raise ctypes.WinError()
+            return subprocess.CompletedProcess(args, 0, stdout=str(status.avail_phys // (1024 * 1024)), stderr="")
+        return original(args, **kwargs)
+    subprocess.run = dotaz
+    try:
+        return L.cekej_na_ram(1500)
+    finally:
+        subprocess.run = original
+
+
+def cti_pred_2021(cesta):
+    # Filtr už při čtení: ani tvorba zpoždění/odmocnin nepracuje na testu.
+    meta = pq.ParquetFile(cesta).schema_arrow.metadata
+    idx = json.loads(meta[b"pandas"])["index_columns"][0]
+    assert isinstance(idx, str), idx
+    d = pd.read_parquet(cesta, filters=[(idx, "<", L.KONEC)])
+    assert isinstance(d.index, pd.DatetimeIndex)
+    assert (d.index < L.KONEC).all()
+    return d
+
+
+@cache
+def tymova_data():
+    return cti_pred_2021(data.SOUBOR).astype("float64")
+
+
+@cache
+def rozsirena_data():
+    return cti_pred_2021(L.data_ridge.SOUBOR).astype("float64")
+
+
+data.nacti = tymova_data
+features.nacti = tymova_data
+evaluate.nacti = tymova_data
+L.data_ridge.nacti = rozsirena_data
+
+
+def validace_pevna(a, b=None):
+    da = cti_pred_2021(RIDGE / "stanice_vsem" / a)
+    assert {"y", "pred"} <= set(da.columns)
+    assert da.index.is_unique and da.index.is_monotonic_increasing
+    assert ((da.index + pd.Timedelta(hours=24)) < L.KONEC).all()
+    assert (evaluate.casti("decin", 24).reindex(da.index) == "val").all()
+    np.testing.assert_allclose(da.y.to_numpy(), L.zaklad(24)[1].reindex(da.index).to_numpy(), atol=1e-8, rtol=0)
+    if b:
+        db = cti_pred_2021(RIDGE / "stanice_vsem" / b)
+        assert da.index.equals(db.index)
+        np.testing.assert_array_equal(da.y.to_numpy(), db.y.to_numpy())
+        pr = (da.pred.to_numpy() + db.pred.to_numpy()) / 2
+    else:
+        pr = da.pred.to_numpy()
+    return evaluate.vyhodnot(da.y, pr, "decin", 24)
+
+
+def vahy_zapis(vahy, pov):
+    return [dict(fold=k, povoden=p["nazev"], w=float(w)) for k, (p, w) in enumerate(zip(pov, vahy))]
+
+
+def hlavni():
+    log("Čekám na RAM: lofo.cekej_na_ram(1500).")
+    ram = cekej_ram()
+    if ram is None:
+        raise RuntimeError("Nedostatek volné RAM po čekání dle protokolu.")
+    log(f"Volná RAM {ram} MB; načítám jen roky 2006–2020.")
+    A12, y = L.matice(24)
+    assert ((y.index + pd.Timedelta(hours=24)) < L.KONEC).all()
+    assert y.index.min().year == 2006
+    m12 = L.Motor(A12.to_numpy(), y, 24)
+    p12, _ = m12.lofo()
+    A30, yy = L.matice(24, nove=L.NOVE)
+    pd.testing.assert_series_equal(y, yy)
+    m30 = L.Motor(A30.to_numpy(), y, 24)
+    p30, _ = m30.lofo()
+    pov = L.povodne_lofo(24)
+    assert len(pov) == 22
+    foldy = pd.read_csv(RIDGE / "stanice_vsem" / "lofo_foldy.csv")
+    foldy = foldy[foldy.horizont == 24].sort_values("fold")
+    assert len(foldy) == 22
+    for k, (_, f) in enumerate(foldy.iterrows()):
+        p = pov[k]
+        ix = y.index[p["okno"]]
+        assert k == f.fold and p["nazev"] == f.povoden
+        assert ix[0] == pd.Timestamp(f.okno_od) and ix[-1] == pd.Timestamp(f.okno_do)
+        assert len(ix) == f.radku_okno and len(y) == f.radku_celkem
+        assert y.index[0] == pd.Timestamp(f.radky_od) and y.index[-1] == pd.Timestamp(f.radky_do)
+    log(f"Ověřena shoda všech 22 foldů s lofo_foldy.csv; řádků {len(y)}, sloupců {A12.shape[1]}/{A30.shape[1]}.")
+
+    refs = {"Ridge12": L.skore(p12, 24), "Ridge30": L.skore(p30, 24, zaklad_pred=p12)}
+    zapis_json("reference_G.json", refs)
+    vysl = []
+    def pridej(nazev, popis, pred, vahy, val=None, **navic):
+        r = dict(nazev=nazev, popis=popis, skore=L.skore(pred, 24, zaklad_pred=p12),
+                 validace=val, vybrane_vahy=vahy, **navic)
+        vysl.append(r)
+        zapis_json("vysledky_G.json", vysl)
+        log(f"{nazev}: {json.dumps(r['skore'], ensure_ascii=False)}")
+
+    g1 = [(a + b) / 2 for a, b in zip(p12, p30)]
+    pridej("G1", "0,5 Ridge30 + 0,5 Ridge12; pevná váha bez výběru.", g1, 0.5)
+
+    g2, w2, vnitrni = [], [], []
+    for k in range(22):
+        chyby = []
+        for j in range(22):
+            if j == k:
+                continue
+            a12, yo = m12.okno(j)
+            a30, _ = m30.okno(j)
+            v12 = L.predikuj(L.ridge_z_souctu(m12.vnitrni(k, j)), a12)
+            v30 = L.predikuj(L.ridge_z_souctu(m30.vnitrni(k, j)), a30)
+            chyby.append(np.abs(GRID[:, None] * v30 + (1 - GRID[:, None]) * v12 - yo).mean(axis=1))
+        errs = np.mean(chyby, axis=0)
+        w = float(GRID[np.argmin(errs)])  # deterministická shoda: nejmenší w
+        w2.append(w)
+        g2.append(w * p30[k] + (1 - w) * p12[k])
+        vnitrni.append(dict(fold=k, w=w, chyby_mrizky=errs.tolist()))
+        m12._vnitrni.clear()
+        m30._vnitrni.clear()
+        log(f"G2 fold {k:02d} {pov[k]['nazev']}: w={w:.1f}, vnitřní MAE={errs.min():.4f}")
+    pridej("G2", "w Ridge30 + (1−w) Ridge12; striktně vnořené LOFO bez mezer k i j; mřížka 0:0,1:1, průměr MAE 21 povodní; shoda → nižší w.",
+           g2, vahy_zapis(w2, pov), vnitrni_chyby=vnitrni,
+           poznamka_validace="Val pro laděné směsi zadání nevyžaduje; nehodnoceno.")
+
+    # Ukládáme i předpovědi a cíle, aby následné doplnění nemuselo přepočítávat modely.
+    rows = []
+    for k, p in enumerate(pov):
+        ix = y.index[p["okno"]]
+        rows.append(pd.DataFrame(dict(fold=k, cas=ix, y=y[p["okno"]].to_numpy(), ridge12=p12[k], ridge30=p30[k], G1=g1[k], G2=g2[k])))
+    pd.concat(rows, ignore_index=True).to_parquet(ZDE / "predpovedi_G.parquet", index=False)
+    gc.collect()
+    log("G1/G2 hotovy; validační soubory ověří doplňovací skript.")
+
+
+if __name__ == "__main__":
+    hlavni()
