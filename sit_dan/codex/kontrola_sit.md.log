  45:             veliciny = "HQ" if keys[dbc] in CILE else "Q"
  46:             if ts["tsConID"][0] in veliciny:
  47:                 v = pd.DataFrame(ts["tsData"]["data"]["values"], columns=["t", "v"])
  48:                 parts.setdefault(f"{keys[dbc]}_{ts['tsConID'][0]}", []).append(v)
  49:     D = pd.DataFrame({
  50:         k: pd.concat(v).assign(t=lambda x: pd.to_datetime(x.t, utc=True)).drop_duplicates("t").set_index("t").v
  51:         for k, v in parts.items()
  52:     }).sort_index()
