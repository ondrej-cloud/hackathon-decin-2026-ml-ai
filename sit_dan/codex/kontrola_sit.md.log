  54:     # chyba m��en�: v D؟�n� stav a� 1 019 cm p�i pr�toku kolem 120 m3/s, �st� p�itom 161 cm,
  55:     # a do 8. 2. dopoledne hladina nesed� s pr�tokem (nejsp�� led). Nedopl�ujeme, surov� data jinak d�ry nemaj�.
  56:     D.loc["2006-02-05":"2006-02-08 09:00", "decin_H"] = None
  57:     cols = [f"{k}_{v}" for k in CILE for v in "HQ"] + [f"{k}_Q" for k in PROTI_PROUDU]
  58:     D[cols].astype("float32").rename_axis("cas").to_parquet(SOUBOR)
  59:     return D[cols]
  60: 
  61: 
  62: @cache
  63: def nacti():
  64:     """Hodinov� tabulka, index je �as v UTC, sloupce <stanice>_H (cm) a <stanice>_Q (m3/s)."""
  65:     return pd.read_parquet(SOUBOR).astype("float64")
  66: 
  67: 
  68: if __name__ == "__main__":
  69:     D = postav()
  70:     print(f"{len(D)} hodin, {D.shape[1]} sloupc�, �pln�ch ��dk� {int(D.notna().all(axis=1).sum())}")
  71:     print("chyb� (hodin):", D.isna().sum()[lambda s: s > 0].to_dict())
  72:     print(f"{SOUBOR.relative_to(ROOT)}: {SOUBOR.stat().st_size / 1e6:.1f} MB")
