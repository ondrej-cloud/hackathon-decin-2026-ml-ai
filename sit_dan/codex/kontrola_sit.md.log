   1: """Spole�n� rozd�len� na train / val / test a vyhodnocen�. Nikdo ho nem�n� jen pro sv�j model.
   2: 
   3: - train: 2006-2018 bez valida�n�ch povodn� a 20 dn� kolem nich
   4: - val: 4 vynechan� povodn� (16 dn� p�ed vrcholem a� 5 dn� po n�m) a klidn� roky 2019-2020
   5: - test: 2021-2025 (povodn� 12/2023 a 9/2024), pou�t� se jednou na konci, rozhoduje Ondra.
   6:   Fin�ln� model se pak tr�nuje na v�em do konce 2020.
   7: """
   8: import numpy as np
   9: import pandas as pd
  10: 
  11: from data import SPA, nacti
  12: from features import NEJSTARSI
  13: 
  14: POVODNE_VAL = ["2006-04-03", "2009-03-07", "2010-09-29", "2011-01-17"]
  15: KLID_VAL = ("2019-01-01", "2020-12-31")
  16: TEST_OD = "2021-01-01"
  17: OKNO_VAL, PRED, PO, VYNECHAT = pd.Timedelta(days=16), pd.Timedelta(days=7), pd.Timedelta(days=5), pd.Timedelta(days=20)
  18: 
  19: 
  20: def povodne(H, prah):
  21:     """Vrcholy povodn�, kdy stav p�e�el pr�h (v�c ne� 7 dn� od sebe = r�zn� povodn�)."""
  22:     s = H[H >= prah]
  23:     useky = []
  24:     for t in s.index:
  25:         if useky and t - useky[-1][1] <= pd.Timedelta(days=7):
  26:             useky[-1][1] = t
  27:         else:
  28:             useky.append([t, t])
  29:     return [H[a:b].idxmax() for a, b in useky]
  30: 
  31: 
  32: def casti(cil, horizont, finalni=False):
  33:     """Pro ka�dou hodinu 'train', 'val', 'test' nebo '' (nepou��t)."""
  34:     H = nacti()[f"{cil}_H"]
  35:     c = pd.Series("train", index=H.index)
  36:     if not finalni:
  37:         vrcholy = [H[pd.Timestamp(d, tz="UTC") - pd.Timedelta(days=3):][:144].idxmax() for d in POVODNE_VAL]
  38:         for v in vrcholy:
  39:             c[v - OKNO_VAL - VYNECHAT: v + PO + VYNECHAT] = ""
  40:         c[KLID_VAL[0]:KLID_VAL[1]] = "val"
  41:         for v in vrcholy:
  42:             c[v - OKNO_VAL: v + PO] = "val"
  43:     c[TEST_OD:] = "test"
  44:     # vstupy (a� 36 h zp�t) i c�l (t + horizont) mus� le�et ve stejn� ��sti, jinak ��dek vynech�me
  45:     ok = (c == c.shift(-horizont)) & (c == c.shift(NEJSTARSI))
  46:     return c.where(ok, "")
  47: 
  48: 
  49: def varovani(y, pred, prah, horizont):
  50:     """Varov�n� p�ed p�ekro�en�m prahu. y a pred: index je �as vyd�n� t, hodnota je stav v t + horizont.
  51: 
  52:     P�edstih je nejv�� horizont: d��v�j� varov�n� znamen�, �e model ohl�sil povode� d��v, ne� mohla p�ij�t.
  53:     Prop�snut� povode� se do pr�m�rn�ho p�edstihu po��t� jako 0.
  54:     """
  55:     hodiny = pd.date_range(y.index.min(), y.index.max(), freq="h")
  56:     y, pred = y.reindex(hodiny), pred.reindex(hodiny)
  57:     alarm = (pred >= prah).astype(int)
  58:     # za��tek povodn�: skute�n� stav p�ejde pr�h a 4 dny p�edt�m byl zm��en� a pod n�m
  59:     pod = (y < prah).astype(float).where(y.notna())
  60:     zacatky = hodiny[(y >= prah) & (pod.shift(1).rolling(96, min_periods=96).min() == 1)]
  61:     predstih, propasnuto = [], 0
  62:     for t in zacatky:
  63:         vydane = alarm[t - pd.Timedelta(hours=48): t + pd.Timedelta(hours=horizont - 1)]
  64:         if vydane.any():
  65:             predstih.append(min(horizont, horizont - (vydane.idxmax() - t) / pd.Timedelta(hours=1)))
  66:         else:
  67:             predstih.append(0.0)
  68:             propasnuto += 1
  69:     # plan� poplach: souvisl� �sek varov�n� (mezery do 6 h spoj�me), b�hem kter�ho ani den po n�m
  70:     # skute�n� stav pr�h nep�ekro�il (y[t] je stav v t + horizont, proto od s - horizont)
  71:     a = alarm.rolling(7, min_periods=1).max()
  72:     starty = hodiny[(a == 1) & (a.shift(1, fill_value=0) == 0)]
  73:     konce = hodiny[(a == 1) & (a.shift(-1, fill_value=0) == 0)]
  74:     plane = sum(not (y[s - pd.Timedelta(hours=horizont): e + pd.Timedelta(hours=24)] >= prah).any()
  75:                 for s, e in zip(starty, konce))
  76:     return dict(povodni=len(zacatky), predstih_h=round(float(np.mean(predstih)), 1) if predstih else None,
  77:                 propasnuto=propasnuto, plane_poplachy=int(plane))
  78: 
  79: 
  80: def vyhodnot(y, pred, cil, horizont):
  81:     """Metriky jedn� p�edpov�di (stav v cm). y a pred maj� stejn� index, �as vyd�n� p�edpov�di."""
  82:     pred = pd.Series(np.asarray(pred, dtype=float), index=y.index)
  83:     e = (pred - y).abs()
  84:     spa1, spa2, spa3 = SPA[cil]
  85:     okno = pd.Series(False, index=y.index)
  86:     vrcholy = []
  87:     for v in povodne(y, spa2):
  88:         okno[v - PRED: v + PO] = True
  89:         # p�edpov�� vydan� horizont hodin p�ed vrcholem, kladn� = nadhodnotil
  90:         vrcholy.append(pred[v] - y[v])
  91:     out = dict(
  92:         mae=round(e.mean(), 1),
  93:         mae_povodne=round(e[okno].mean(), 1),
  94:         # kladn� = model na povodn�ch soustavn� nadhodnocuje (pozor, nadhodnocov�n� zlep�uje p�edstih)
  95:         bias_povodne=round((pred - y)[okno].mean(), 1),
  96:         mae_nad_1spa=round(e[y >= spa1].mean(), 1),
  97:         chyba_vrcholu=round(float(np.mean(np.abs(vrcholy))), 1),
  98:         vrcholy_o_kolik=[round(float(v)) for v in vrcholy],
  99:         radku=len(y),
 100:     )
 101:     for n, prah in ((2, spa2), (3, spa3)):
 102:         out |= {f"spa{n}_{k}": v for k, v in varovani(y, pred, prah, horizont).items()}
 103:     return out
