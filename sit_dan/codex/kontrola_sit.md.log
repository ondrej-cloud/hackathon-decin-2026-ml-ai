import sys
from pathlib import Path
import pandas as pd
root=Path.cwd()
sys.path[:0]=[str(root/'src'),str(root/'sit_dan')]
import data as D
import data_ridge as R
import stanice
end=pd.Timestamp('2021-01-01',tz='UTC')
filters=[('cas','<',end)]
team=pd.read_parquet(D.SOUBOR,filters=filters).astype('float64')
new=[k for k,_ in stanice.HYDRO.values() if k not in stanice.TYM]
cols=['decin_H']+[s+'_Q' for s in new]
extra=pd.read_parquet(R.SOUBOR,columns=cols,filters=filters).astype('float64')
D.nacti=lambda:team
R.nacti=lambda:extra
import spolecne as S
import beh_sit as B
from models import mlp
for name,df in [('team',team),('extra',extra)]:
 print(name,'rows',len(df),'tz',str(df.index.tz),'unique',df.index.is_unique,'sorted',df.index.is_monotonic_increasing,'hourly',bool((df.index.to_series().diff().dropna()==pd.Timedelta(hours=1)).all()))
print('aux_decin_H_equal',team.decin_H.equals(extra.decin_H))
N=S.nove_sloupce()
for c,h in S.VSE:
 X0,y0=S.tabulka(c,h)
 X,Xn,y,parts=S.data(c,h)
 p0=S.casti(c,h).reindex(X0.index)
 print(c,h,'cols',X.shape[1],Xn.shape[1],'removed',len(X0)-len(X),'removed_train',int(((p0=='train')&~X0.index.isin(X.index)).sum()),'removed_val',int(((p0=='val')&~X0.index.isin(X.index)).sum()),'same_X',X.equals(X0),'same_y',y.equals(y0),'rows_equal',X.index.equals(Xn.index))
 if (c,h)==('decin',24):
  tr=parts=='train'
  folds=S.Hd.bloky_cv(X.index[tr])
  coverage=sum((f[2].astype(int) for f in folds))
  print('CV_each_row_once',bool((coverage==1).all()),'fold_sizes',[(name,int(a.sum()),int(b.sum())) for name,a,b in folds])
Q=mlp.odmocnina_prutoku(N.iloc[100:102])
print('new_Q_transform_ok',bool((Q.to_numpy()**2-N.iloc[100:102].clip(lower=0).to_numpy()).max()<1e-8))
print('mlp_module',mlp.__file__)
print('versions',sys.version.split()[0])
import sklearn,numpy
print('sklearn',sklearn.__version__,'numpy',numpy.__version__,'pandas',pd.__version__)
