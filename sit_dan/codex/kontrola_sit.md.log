  16: SOUBOR = ROOT / "data/external/labe_hodinove.parquet"
  17: 
  18: # kl�� stanice: (��slo �HM�, n�zev). U c�l� bereme stav i pr�tok, u ostatn�ch jen pr�tok.
  19: CILE = {"decin": ("240000", "D؟�n (Labe)"), "usti": ("221000", "�st� nad Labem (Labe)")}
  20: PROTI_PROUDU = {
  21:     "louny": ("219000", "Louny (Oh�e)"),
  22:     "melnik": ("204000", "M�ln�k (Labe)"),
  23:     "vranany": ("203000", "Vra�any (Vltava)"),
  24:     "kostelec": ("104400", "Kostelec nad Labem (Labe)"),
  25:     "praha": ("200100", "Praha-Chuchle (Vltava)"),
  26:     "nymburk": ("080000", "Nymburk (Labe)"),
  27:     "jizera": ("101800", "P�edm��ice (Jizera)"),
  28:     "beroun": ("198000", "Beroun (Berounka)"),
  29:     "sazava": ("167200", "Nespeky (S�zava)"),
  30:     "prelouc": ("061000", "P�elou� (Labe)"),
  31: }
  32: # stupn� povod�ov� aktivity v cm (metadata �HM�)
  33: SPA = {"decin": (400, 490, 560), "usti": (450, 530, 600)}
  34: OD, DO = "2006-01-01", "2025-12-31"  # Kostelec a pr�tok v M�ln�ku a Nymburku za��naj� a� 2006
  35: 
  36: 
  37: def postav():
  38:     keys = {dbc: k for k, (dbc, _) in (CILE | PROTI_PROUDU).items()}
  39:     parts = {}
  40:     for f in glob.glob(str(RAW / "H_0-203-1-*_HQ_*.json")):
  41:         dbc, rok = re.search(r"1-(\d+)_HQ_(\d{4})", f).groups()
  42:         if dbc not in keys or not OD[:4] <= rok <= DO[:4]:
  43:             continue
